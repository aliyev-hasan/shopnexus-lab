# ShopNexus Lab — local configuration
# Copy this file to .env before running:  cp .env.example .env
# Bu fayl yalnız lokal lab üçündür. Real secret istifadə etməyin.

NODE_ENV=development
PORT=3000

# Boş buraxın ki, qəbz/QR linkləri sorğunun host-undan qurulsun.
# Set etsəniz (məs. https://example.com), bütün mütləq linklər həmin ünvana yazılacaq.
PUBLIC_BASE_URL=

# Lab üçün dummy secret-lər — başqa heç bir yerdə istifadə etməyin.
JWT_SECRET=development-only-jwt-key
SESSION_SECRET=development-only-session-key

# Yalnız `npm run seed` ilə datanı sıfırdan qurarkən istifadə olunur.
DEMO_ACCOUNT_PASSWORD=ShopNexusLab2026!
