<!DOCTYPE html>
<html lang="az">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= product.name %></title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body class="bg-slate-50 text-slate-900">
  <%- include('../partials/navbar', { user: user || null }) %>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid lg:grid-cols-2 gap-10 bg-white rounded-[2.5rem] p-6 lg:p-10 shadow-sm border border-slate-200">
      <% const gallery = (product.image_urls && product.image_urls.length ? product.image_urls : [product.image_url]).filter(Boolean); %><div><img id="mainProductImage" src="<%= gallery[0] || '' %>" alt="<%= product.name %>" class="w-full h-[520px] object-cover rounded-[2rem]"><div class="grid grid-cols-4 gap-3 mt-3"><% gallery.slice(0,4).forEach((image,index)=>{ %><button type="button" class="overflow-hidden rounded-2xl border-2 <%= index===0?'border-teal-500':'border-transparent' %>" onclick="document.getElementById('mainProductImage').src=this.querySelector('img').src"><img src="<%= image %>" alt="<%= product.name %> görünüş <%= index+1 %>" class="h-24 w-full object-cover opacity-90 hover:opacity-100"></button><% }) %></div></div>
      <div class="py-4"><span class="px-3 py-1 rounded-full bg-teal-100 text-teal-700 font-black text-sm"><%= product.category %></span><h1 class="text-4xl lg:text-5xl font-black mt-4"><%= product.name %></h1><div class="mt-4 text-amber-400"><% for(let i=1;i<=5;i++){ %><i class="fa-star <%= i <= Math.round(product.rating || 0) ? 'fa-solid' : 'fa-regular' %>"></i><% } %><span class="text-slate-500 ml-2"><%= product.reviews_count || 0 %> <%= t('product.reviews_word') %></span></div><p class="mt-6 text-slate-600 text-lg"><%= product.description || '' %></p><div class="mt-6 flex items-end gap-3"><span class="text-5xl font-black"><%= money(product.price) %> ₼</span><% if(product.oldPrice){ %><span class="text-xl text-slate-400 line-through"><%= money(product.oldPrice) %> ₼</span><% } %></div><p class="mt-4 font-bold <%= product.stock_quantity > 5 ? 'text-emerald-600' : (product.stock_quantity > 0 ? 'text-amber-600' : 'text-rose-600') %>"><i class="fa-solid fa-box mr-2"></i><%= product.stock_quantity > 5 ? t('product.in_stock') + ' (' + product.stock_quantity + ')' : (product.stock_quantity > 0 ? t('product.low_stock', { n: product.stock_quantity }) : t('product.out_of_stock')) %></p><p class="mt-2 text-slate-500"><i class="fa-solid fa-store mr-2"></i><%= t('product.seller') %>: <% if (typeof vendor !== 'undefined' && vendor) { %><a href="/vendors/<%= vendor._id %>" class="text-teal-600 font-bold hover:underline"><%= vendor.store_name %></a><% } else { %><%= product.vendor_name || 'ShopNexus Vendor' %><% } %></p><div class="mt-8 flex gap-3"><% if (user && user.role==='Customer') { %><form action="/cart/add" method="POST" class="flex-1"><input type="hidden" name="productId" value="<%= product._id %>"><input type="hidden" name="quantity" value="1"><input type="hidden" name="redirect" value="/products/<%= product._id %>"><button class="w-full rounded-2xl bg-slate-950 text-white py-4 font-black hover:bg-teal-600" <%= product.stock_quantity<=0?'disabled':'' %>><i class="fa-solid fa-cart-plus mr-2"></i><%= t('product.add_to_cart') %></button></form><button aria-label="<%= t('product.add_to_wishlist') %>" class="wishlist-toggle rounded-2xl bg-rose-50 text-rose-600 px-6 font-bold" data-product-id="<%= product._id %>" title="<%= t('product.add_to_wishlist') %>"><i class="<%= (wishlistIds || []).includes(product._id) ? 'fa-solid fa-heart text-rose-600' : 'fa-regular fa-heart' %>" aria-hidden="true"></i></button><% } else if (!user) { %><a href="/auth/login" class="flex-1 rounded-2xl bg-slate-950 text-white py-4 font-black text-center hover:bg-teal-600"><i class="fa-solid fa-cart-plus mr-2"></i><%= t('product.add_to_cart') %></a><a href="/auth/login" class="rounded-2xl bg-rose-50 text-rose-600 px-6 font-bold" title="<%= t('product.add_to_wishlist') %>"><i class="fa-regular fa-heart"></i></a><% } %></div></div>
    </div>
    <section class="grid lg:grid-cols-2 gap-8 mt-10"><div class="bg-white rounded-[2rem] p-5 sm:p-8 border border-slate-200"><h2 class="text-2xl font-black mb-5"><%= t('product.reviews_title') %></h2><% (reviews || []).forEach(review => { %><div class="border-b py-4"><div class="text-amber-400"><% for(let i=1;i<=5;i++){ %><i class="fa-star <%= i <= review.rating ? 'fa-solid' : 'fa-regular' %>"></i><% } %></div><p class="mt-2 text-slate-600"><%= review.comment || '' %></p></div><% }) %></div><div class="bg-white rounded-[2rem] p-5 sm:p-8 border border-slate-200"><h2 class="text-2xl font-black mb-5"><%= t('product.write_review') %></h2><% if (user && user.role==='Customer') { %><form action="/reviews" method="POST" class="space-y-4"><input type="hidden" name="productId" value="<%= product._id %>"><select name="rating" class="w-full rounded-2xl bg-slate-100 p-4"><option value="5"><%= t('product.star_option', { n: 5 }) %></option><option value="4"><%= t('product.star_option', { n: 4 }) %></option><option value="3"><%= t('product.star_option', { n: 3 }) %></option><option value="2"><%= t('product.star_option', { n: 2 }) %></option><option value="1"><%= t('product.star_option', { n: 1 }) %></option></select><textarea name="comment" placeholder="<%= t('product.comment_placeholder') %>" class="w-full rounded-2xl bg-slate-100 p-4 h-32"></textarea><button class="rounded-2xl bg-teal-600 text-white px-6 py-3 font-black"><%= t('product.submit') %></button></form><% } else if(!user) { %><p class="text-slate-500"><%= t('product.login_prompt_review') %> <a href="/auth/login" class="text-teal-600 font-bold"><%= t('product.login_link') %></a>.</p><% } else { %><p class="rounded-2xl bg-slate-50 p-4 text-sm text-slate-500">Rəy yazmaq yalnız müştəri hesabları üçün əlçatandır.</p><% } %></div></section>
    <section id="qa" class="grid lg:grid-cols-2 gap-8 mt-10"><div class="bg-white rounded-[2rem] p-5 sm:p-8 border border-slate-200"><h2 class="text-2xl font-black mb-5"><%= t('product.qa_title') %></h2><% if (!(questions || []).length) { %><p class="text-slate-500"><%= t('product.qa_empty') %></p><% } %><% (questions || []).forEach(q => { %><div class="border-b py-4"><p class="font-bold text-slate-800"><i class="fa-solid fa-circle-question text-teal-600 mr-2"></i><%= t('product.qa_question_label') %> <span class="font-normal text-slate-400 text-sm">— <%= q.asker_name %></span></p><p class="mt-1 text-slate-600"><%= q.question_text %></p><p class="font-bold text-slate-800 mt-4"><i class="fa-solid fa-reply text-emerald-600 mr-2"></i><%= t('product.qa_answer_label') %></p><p class="mt-1 text-slate-600"><%= q.answer_text %></p></div><% }) %></div><div class="bg-white rounded-[2rem] p-5 sm:p-8 border border-slate-200"><h2 class="text-2xl font-black mb-5"><%= t('product.qa_ask_title') %></h2><% if (user && user.role==='Customer') { %><form action="/questions" method="POST" class="space-y-4"><input type="hidden" name="productId" value="<%= product._id %>"><textarea name="questionText" required placeholder="<%= t('product.qa_placeholder') %>" class="w-full rounded-2xl bg-slate-100 p-4 h-32"></textarea><button class="rounded-2xl bg-teal-600 text-white px-6 py-3 font-black"><%= t('product.qa_submit') %></button></form><p class="mt-3 text-slate-400 text-sm"><%= t('product.qa_note') %></p><% } else if(!user) { %><p class="text-slate-500"><%= t('product.login_prompt_qa') %> <a href="/auth/login" class="text-teal-600 font-bold"><%= t('product.login_link') %></a>.</p><% } else { %><p class="rounded-2xl bg-slate-50 p-4 text-sm text-slate-500">Məhsul sualı vermək yalnız müştəri hesabları üçün əlçatandır.</p><% } %></div></section>
    <section class="mt-12"><h2 class="text-3xl font-black mb-6"><%= t('product.similar_products') %></h2><div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6"><% (similar || []).forEach(product => { %><%- include('../partials/product-card', { product }) %><% }) %></div></section>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
