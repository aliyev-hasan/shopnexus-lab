<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= t('catalog.page_title') %></title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body class="bg-slate-50 text-slate-900">
  <%- include('../partials/navbar', { user: user || null }) %>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="rounded-[2rem] bg-gradient-to-r from-teal-600 to-emerald-600 text-white p-8 mb-8"><h1 class="text-4xl font-black"><%= t('catalog.hero_title') %></h1><p class="text-teal-100 mt-2"><%= t('catalog.hero_subtitle') %></p></div>
    <div class="grid lg:grid-cols-[280px_1fr] gap-8">
      <aside class="bg-white rounded-[1.75rem] p-6 shadow-sm border border-slate-200 h-fit sticky top-24">
        <h2 class="font-black text-xl mb-5"><i class="fa-solid fa-sliders mr-2 text-teal-600"></i><%= t('catalog.filter_heading') %></h2>
        <form class="space-y-5" action="/products">
          <input name="search" value="<%= query.search || '' %>" autocomplete="off" placeholder="<%= t('catalog.search_placeholder') %>" class="w-full rounded-2xl bg-slate-100 px-4 py-3 outline-none focus:ring-2 focus:ring-teal-500">
          <div>
            <label class="font-bold text-sm"><%= t('catalog.category_label') %></label>
            <select name="categorySelect" id="categorySelect" class="mt-2 w-full rounded-2xl bg-slate-100 px-4 py-3">
              <option value=""><%= t('catalog.all_option') %></option>
              <% categories.forEach(c => { %><option value="<%= c %>" <%= query.category===c?'selected':'' %>><%= c %></option><% }) %>
            </select>
            <input type="hidden" name="category" id="categoryInput" value="<%= query.category || '' %>">
            <div class="mt-3 space-y-2 max-h-40 overflow-y-auto">
              <% categories.forEach(c => { %>
                <label class="flex items-center gap-2 text-sm text-slate-600"><input type="checkbox" class="category-cb accent-teal-600" value="<%= c %>" <%= (query.category||'').split(',').includes(c)?'checked':'' %>> <%= c %></label>
              <% }) %>
            </div>
          </div>
          <div>
            <label class="font-bold text-sm"><%= t('catalog.price_range_label') %></label>
            <div class="grid grid-cols-2 gap-3 mt-2"><input name="min" type="number" min="0" step="0.01" value="<%= query.min || '' %>" placeholder="Min" class="min-w-0 rounded-2xl bg-slate-100 px-4 py-3"><input name="max" type="number" min="0" step="0.01" value="<%= query.max || '' %>" placeholder="Max" class="min-w-0 rounded-2xl bg-slate-100 px-4 py-3"></div>
          </div>
          <select name="rating" class="w-full rounded-2xl bg-slate-100 px-4 py-3"><option value=""><%= t('catalog.rating_label') %></option><option value="4" <%= query.rating==='4'?'selected':'' %>><%= t('catalog.rating_4') %></option><option value="3" <%= query.rating==='3'?'selected':'' %>><%= t('catalog.rating_3') %></option><option value="2" <%= query.rating==='2'?'selected':'' %>><%= t('catalog.rating_2') %></option></select>
          <select name="sort" class="w-full rounded-2xl bg-slate-100 px-4 py-3"><option value=""><%= t('catalog.sort_label') %></option><option value="price-asc" <%= query.sort==='price-asc'?'selected':'' %>><%= t('catalog.sort_price_asc') %></option><option value="price-desc" <%= query.sort==='price-desc'?'selected':'' %>><%= t('catalog.sort_price_desc') %></option><option value="newest" <%= query.sort==='newest'?'selected':'' %>><%= t('catalog.sort_newest') %></option><option value="rating-desc" <%= query.sort==='rating-desc'?'selected':'' %>>Reytinq yüksəkdən</option></select>
          <button class="w-full rounded-2xl bg-slate-950 text-white font-black py-3"><%= t('catalog.apply_button') %></button>
        </form>
      </aside>
      <section>
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5">
          <div>
            <p class="text-sm font-black uppercase tracking-wider text-teal-600"><%= t('catalog.results_label') %></p>
            <h2 class="text-3xl font-black"><%= t('catalog.results_found', { n: products.length }) %></h2>
            <% if (query.category || query.search || query.min || query.max || query.rating) { %>
              <p class="text-sm text-slate-500 mt-1">
                <% if (query.search) { %><%= t('catalog.search_prefix') %> "<%= query.search %>"<% } %>
                <% if (query.category) { %><%= t('catalog.category_prefix') %> <%= query.category %><% } %>
                <% if (query.min || query.max) { %><%= t('catalog.price_prefix') %> <%= query.min || 0 %>-<%= query.max || 2000 %> ₼<% } %>
                <% if (query.rating) { %><%= query.rating %>+ <i class="fa-solid fa-star text-amber-400"></i><% } %>
              </p>
            <% } %>
          </div>
          <% if ((products||[]).length) { %>
          <span class="text-sm text-slate-500 font-bold"><%= t('catalog.results_showing', { n: products.length }) %></span>
          <% } %>
        </div>
        <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-6"><% (products || []).forEach(product => { %><%- include('../partials/product-card', { product }) %><% }) %></div><% if (!products || products.length === 0) { %><div class="bg-white rounded-3xl p-10 text-center"><i class="fa-solid fa-magnifying-glass text-3xl text-slate-300 mb-3"></i><p class="font-black text-lg"><%= t('catalog.empty_title') %></p><p class="text-slate-500 text-sm mt-1"><%= t('catalog.empty_subtitle') %></p><a href="/products" class="inline-block mt-4 text-teal-600 font-bold"><%= t('catalog.clear_filters') %></a></div><% } %></section>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
  <script>
    (() => {
      const categoryInput = document.getElementById('categoryInput');
      const checkboxes = document.querySelectorAll('.category-cb');
      const syncCategories = () => {
        categoryInput.value = [...document.querySelectorAll('.category-cb:checked')].map(cb => cb.value).join(',');
      };
      checkboxes.forEach(cb => cb.addEventListener('change', syncCategories));
      document.getElementById('categorySelect').addEventListener('change', event => {
        checkboxes.forEach(cb => { cb.checked = event.target.value !== '' && cb.value === event.target.value; });
        syncCategories();
      });
    })();
  </script>
</body>
</html>
