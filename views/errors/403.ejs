<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Giriş qadağandır | ShopNexus</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">
  <%- include('../partials/navbar', { user: user || null }) %>

  <main class="flex-1 grid place-items-center px-4 py-16 sm:py-24">
    <section class="w-full max-w-xl rounded-[2rem] bg-white border border-slate-200 shadow-sm p-8 sm:p-12 text-center">
      <div class="mx-auto mb-7 w-24 h-24 rounded-3xl bg-rose-100 text-rose-600 grid place-items-center">
        <i class="fa-solid fa-lock text-5xl" aria-hidden="true"></i>
      </div>
      <p class="text-rose-600 font-black tracking-widest uppercase text-sm mb-3">403 • Forbidden</p>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight">Giriş qadağandır</h1>
      <p class="mt-4 text-slate-500 text-lg">Bu səhifəyə giriş icazəniz yoxdur.</p>
      <a href="/" class="inline-flex items-center gap-2 mt-8 rounded-2xl bg-slate-950 px-6 py-3.5 text-white font-black hover:bg-teal-600 transition-colors">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        Ana səhifəyə qayıt
      </a>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
