<!DOCTYPE html><html lang="<%= currentLang %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Bütün Satıcılar | ShopNexus</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-50 text-slate-900"><%- include('../partials/navbar',{user:user||null}) %><main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
  <div class="mb-8"><p class="text-sm font-black uppercase tracking-wider text-teal-700">Marketplace directory</p><h1 class="text-4xl font-black sm:text-5xl">Bütün Satıcılar</h1><p class="mt-3 max-w-2xl text-slate-600">Aktiv mağazaları, reytinqlərini və məhsul kataloqlarını kəşf edin.</p></div>
  <form action="/vendors" class="mb-8 grid gap-3 rounded-3xl border bg-white p-5 sm:grid-cols-[1fr_240px_auto]"><input name="search" value="<%= query.search||'' %>" placeholder="Satıcı axtar..." class="rounded-xl border border-slate-300 px-4 py-3"><select name="category" class="rounded-xl border border-slate-300 px-4 py-3"><option value="">Bütün kateqoriyalar</option><% categories.forEach(c=>{ %><option value="<%= c %>" <%= query.category===c?'selected':'' %>><%= c %></option><% }) %></select><button class="rounded-xl bg-slate-950 px-6 py-3 font-black text-white hover:bg-teal-700">Axtar</button></form>
  <% if(!vendorRows.length){ %><div class="rounded-3xl border bg-white p-12 text-center text-slate-500"><i class="fa-solid fa-store-slash mb-3 text-4xl"></i><p class="font-bold">Uyğun aktiv satıcı tapılmadı.</p></div><% } %>
  <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"><% vendorRows.forEach(row=>{ const v=row.vendor; %><article class="group overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl"><div class="relative h-40 bg-slate-900"><% if(v.store_banner){ %><img src="<%= v.store_banner %>" alt="<%= v.store_name %> banneri" class="h-full w-full object-cover opacity-75 transition duration-500 group-hover:scale-105"><% } else { %><div class="h-full bg-gradient-to-br from-slate-950 via-teal-950 to-slate-900"></div><% } %><div class="absolute -bottom-8 left-6"><% if(v.store_logo){ %><img src="<%= v.store_logo %>" alt="<%= v.store_name %> loqosu" class="h-20 w-20 rounded-2xl border-4 border-white bg-white object-cover shadow-lg"><% } else { %><div class="grid h-20 w-20 place-items-center rounded-2xl border-4 border-white bg-teal-600 text-2xl text-white"><i class="fa-solid fa-store"></i></div><% } %></div><% if(v.featured){ %><span class="absolute right-4 top-4 rounded-full bg-amber-400 px-3 py-1 text-xs font-black text-amber-950"><i class="fa-solid fa-certificate mr-1"></i>Seçilmiş</span><% } %></div><div class="p-6 pt-12"><h2 class="text-xl font-black"><%= v.store_name %></h2><p class="mt-2 line-clamp-2 min-h-[2.5rem] text-sm text-slate-500"><%= v.store_description||'Mağaza təsviri əlavə edilməyib.' %></p><div class="mt-4 flex flex-wrap gap-2"><span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-700"><i class="fa-solid fa-star"></i> <%= row.rating?row.rating.toFixed(1):'Yeni' %></span><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold"><%= row.productCount %> məhsul</span><% row.categories.slice(0,2).forEach(c=>{ %><span class="rounded-full bg-teal-50 px-3 py-1 text-xs font-bold text-teal-700"><%= c %></span><% }) %></div><a href="/vendors/<%= v.slug||v._id %>" class="mt-5 block rounded-2xl bg-slate-950 px-5 py-3 text-center font-black text-white hover:bg-teal-700">Mağazaya bax</a></div></article><% }) %></section>
</main><%- include('../partials/footer') %></body></html>
