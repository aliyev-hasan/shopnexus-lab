<aside class="w-64 shrink-0 bg-white border-r border-slate-200 min-h-[calc(100vh-5rem)] sticky top-20 self-start hidden lg:block">
  <div class="p-5"><p class="px-3 mb-4 text-xs font-black uppercase tracking-wider text-slate-400"><%= t('admin_sidebar.management_label') %></p>
    <nav class="space-y-1">
      <% var links = [{key:'dashboard',href:'/admin',icon:'chart-line',label:t('admin_sidebar.dashboard')},{key:'orders',href:'/admin/orders',icon:'receipt',label:t('admin_sidebar.orders')},{key:'products',href:'/admin/products',icon:'box',label:t('admin_sidebar.products')},{key:'categories',href:'/admin/categories',icon:'tags',label:t('admin_sidebar.categories')},{key:'coupons',href:'/admin/coupons',icon:'ticket',label:t('admin_sidebar.coupons')},{key:'questions',href:'/admin/questions',icon:'circle-question',label:t('admin_sidebar.questions')},{key:'support',href:'/admin/support',icon:'life-ring',label:t('admin_sidebar.support')},{key:'users',href:'/admin/users',icon:'users',label:t('admin_sidebar.users')},{key:'vendors',href:'/admin/vendors',icon:'store',label:t('admin_sidebar.vendors')},{key:'settings',href:'/admin/settings',icon:'gear',label:t('admin_sidebar.settings')},{key:'payments',href:'/admin/payments',icon:'credit-card',label:t('admin_sidebar.payments')},{key:'finance',href:'/admin/finance',icon:'chart-column',label:t('admin_sidebar.finance')},{key:'refunds',href:'/admin/refunds',icon:'rotate-left',label:t('admin_sidebar.refunds')},{key:'giftcards',href:'/admin/giftcards',icon:'gift',label:t('admin_sidebar.giftcards')}]; %>
      <% links.forEach(link => { const count=(notificationContextCounts||{})[link.key]||0; %><a href="<%= link.href %>" class="flex items-center gap-3 rounded-xl px-3 py-3 font-bold transition <%= current === link.key ? 'bg-teal-600 text-white' : 'text-slate-600 hover:bg-slate-100' %>"><i class="fa-solid fa-<%= link.icon %> w-5 text-center"></i><span class="flex-1"><%= link.label %></span><% if(count>0){ %><span class="grid min-h-5 min-w-5 place-items-center rounded-full bg-rose-600 px-1 text-xs text-white"><%= count %></span><% } %></a><% }) %>
    </nav>
  </div>
</aside>
<div id="admin-mobile-nav" class="w-0 shrink-0 lg:hidden"><nav class="absolute left-0 right-0 z-20 flex min-w-0 gap-2 overflow-x-auto border-b bg-white p-3"><% links.forEach(link => { const count=(notificationContextCounts||{})[link.key]||0; %><a href="<%= link.href %>" class="whitespace-nowrap px-3 py-2 rounded-lg text-sm font-bold <%= current === link.key ? 'bg-teal-600 text-white' : 'text-slate-600 bg-slate-50' %>"><i class="fa-solid fa-<%= link.icon %> mr-1"></i><%= link.label %><% if(count>0){ %><span class="ml-1 rounded-full bg-rose-600 px-1.5 py-0.5 text-xs text-white"><%= count %></span><% } %></a><% }) %></nav></div>
<style>@media (max-width:1023px){#admin-mobile-nav ~ main{box-sizing:border-box;width:100%;min-width:0;padding-top:5.5rem}#admin-mobile-nav ~ main form,#admin-mobile-nav ~ main form>*{min-width:0;max-width:100%}}</style>
