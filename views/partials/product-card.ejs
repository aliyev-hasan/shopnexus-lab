<div class="group bg-white rounded-[1.75rem] overflow-hidden shadow-sm border border-slate-200 hover:shadow-2xl hover:-translate-y-1 transition">
  <div class="relative h-56 overflow-hidden bg-slate-100">
    <img src="<%= product.image_url %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-110 transition duration-500">
    <span class="absolute left-4 top-4 px-3 py-1 rounded-full bg-rose-600 text-white text-xs font-black"><%= product.badge || t('product.offer_badge') %></span>
    <% if (product.oldPrice) { %><span class="absolute right-4 top-4 px-3 py-1 rounded-full bg-emerald-500 text-white text-xs font-black">-<%= Math.round((1-product.price/product.oldPrice)*100) %>%</span><% } %>
  </div>
  <div class="p-5">
    <p class="text-sm text-teal-600 font-bold"><%= product.category %></p>
    <h3 class="font-black text-lg line-clamp-2 min-h-[3.5rem]"><%= product.name %></h3>
    <% if (product.vendor_name) { %><p class="text-xs text-slate-400 font-bold mt-0.5"><i class="fa-solid fa-store mr-1"></i><%= product.vendor_name %></p><% } %>
    <div class="mt-2 text-amber-400 text-sm"><% for(let i=1;i<=5;i++){ %><i class="fa-star <%= i <= Math.round(product.rating || 0) ? 'fa-solid' : 'fa-regular' %>"></i><% } %><span class="text-slate-500 ml-2">(<%= product.reviews_count || 0 %>)</span></div>
    <div class="mt-4 flex items-end gap-2"><span class="text-2xl font-black tabular-nums"><%= money(product.price) %> ₼</span><% if(product.oldPrice){ %><span class="line-through text-slate-400"><%= money(product.oldPrice) %> ₼</span><% } %></div>
     <p class="mt-2 text-xs font-bold <%= product.stock_quantity > 5 ? 'text-emerald-600' : (product.stock_quantity > 0 ? 'text-amber-600' : 'text-rose-600') %>"><%= product.stock_quantity > 5 ? t('product.in_stock') : (product.stock_quantity > 0 ? t('product.low_stock', { n: product.stock_quantity }) : t('product.out_of_stock')) %></p>
    <div class="mt-5 flex gap-2">
      <a href="/products/<%= product._id %>" class="flex-1 text-center px-4 py-3 rounded-2xl bg-slate-950 text-white font-bold hover:bg-teal-600"><%= t('product.details') %></a>
      <% if (user) { %>
      <form action="/cart/add" method="POST"><input type="hidden" name="productId" value="<%= product._id %>"><input type="hidden" name="quantity" value="1"><input type="hidden" name="redirect" value="/products"><button aria-label="<%= t('product.add_to_cart') %>" class="px-4 py-3 rounded-2xl bg-teal-50 text-teal-600 font-bold disabled:opacity-40 disabled:cursor-not-allowed" title="<%= t('product.add_to_cart') %>" <%= product.stock_quantity <= 0 ? 'disabled' : '' %>><i class="fa-solid fa-cart-plus" aria-hidden="true"></i></button></form>
      <button aria-label="<%= t('product.add_to_wishlist') %>" class="wishlist-toggle px-4 py-3 rounded-2xl bg-rose-50 font-bold" data-product-id="<%= product._id %>" title="<%= t('product.add_to_wishlist') %>"><i class="<%= (typeof wishlistIds !== 'undefined' && wishlistIds.includes(product._id)) ? 'fa-solid fa-heart text-rose-600' : 'fa-regular fa-heart' %>" aria-hidden="true"></i></button>
      <% } else { %>
      <a href="/auth/login" class="px-4 py-3 rounded-2xl bg-teal-50 text-teal-600 font-bold"><i class="fa-solid fa-cart-plus"></i></a>
      <a href="/auth/login" class="px-4 py-3 rounded-2xl bg-rose-50 text-rose-600 font-bold"><i class="fa-solid fa-heart"></i></a>
      <% } %>
    </div>
  </div>
</div>
