<footer class="mt-20 bg-slate-950 text-slate-300">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-4 lg:px-8">
    <div><h3 class="mb-3 text-2xl font-black text-white">ShopNexus</h3><p><%= t('footer.tagline') %></p><a href="/vendors" class="mt-4 inline-flex items-center gap-2 font-bold text-teal-300 hover:text-white">Bütün satıcılar <i class="fa-solid fa-arrow-right text-xs"></i></a></div>
    <div><h4 class="mb-3 font-bold text-white"><%= t('footer.categories') %></h4><nav class="space-y-2"><a class="block hover:text-white" href="/products?category=Elektronika"><%= t('footer.cat_electronics') %></a><a class="block hover:text-white" href="/products?category=Geyim"><%= t('footer.cat_clothing') %></a><a class="block hover:text-white" href="/products?category=Aksessuar"><%= t('footer.cat_accessories') %></a><a class="block hover:text-white" href="/products?category=Ev%20%C9%99%C5%9Fyalar%C4%B1"><%= t('footer.cat_home') %></a></nav></div>
    <div><h4 class="mb-3 font-bold text-white"><%= t('footer.support') %></h4><div class="space-y-2"><span class="block cursor-default text-slate-500" title="Ayrıca çatdırılma səhifəsi mövcud deyil"><%= t('footer.shipping') %></span><% if(user){ %><a class="block hover:text-white" href="<%= user.role==='Vendor'?'/vendor/support':user.role==='Admin'?'/admin/support':'/user/profile?tab=support' %>">Dəstək</a><a class="block hover:text-white" href="<%= user.role==='Admin'?'/admin/refunds':user.role==='Customer'?'/user/profile?tab=refunds':'/vendor/sales?context=returns' %>"><%= t('footer.returns') %></a><% if(user.role==='Admin'||user.role==='Vendor'){ %><a class="block hover:text-white" href="<%= user.role==='Admin'?'/admin/coupons':'/vendor/coupons' %>"><%= t('footer.coupons') %></a><% } else { %><span class="block cursor-default text-slate-500"><%= t('footer.coupons') %></span><% } %><% } else { %><a class="block hover:text-white" href="/auth/login">Dəstək</a><span class="block cursor-default text-slate-500"><%= t('footer.returns') %></span><span class="block cursor-default text-slate-500"><%= t('footer.coupons') %></span><% } %></div></div>
    <div><h4 class="mb-3 font-bold text-white"><%= t('footer.follow_us') %></h4><p class="mb-3 text-sm text-slate-500">ShopNexus sosial hesabı</p><div class="flex gap-3 text-xl"><a href="https://www.instagram.com/hsn__052/" target="_blank" rel="noopener noreferrer" aria-label="ShopNexus Instagram" class="text-slate-400 transition hover:text-pink-400"><i class="fa-brands fa-instagram"></i></a><span class="text-slate-700"><i class="fa-brands fa-facebook"></i></span><span class="text-slate-700"><i class="fa-brands fa-x-twitter"></i></span></div></div>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-sm"><%= t('footer.copyright', { year: new Date().getFullYear() }) %></div>
</footer>
