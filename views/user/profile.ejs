<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('profile.title') %> | ShopNexus</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-900">
<%- include('../partials/navbar',{user:user||null}) %>
<main class="mx-auto max-w-5xl px-4 py-10">
  <h1 class="mb-7 text-4xl font-black"><%= t('profile.title') %></h1>
  <nav class="mb-6 flex gap-2 overflow-x-auto rounded-2xl border bg-white p-2">
    <% const customerTabs=[['wallet','tab_wallet'],['payments','tab_payments'],['orders','tab_orders'],['addresses','tab_addresses'],['refunds','tab_refunds'],['reviews','tab_reviews'],['cards','tab_cards']]; let profileTabs=[]; if(user.role==='Customer'){ profileTabs=[['profile','tab_profile'],['questions',null],...customerTabs]; } else if(user.role==='Vendor'){ profileTabs=[['profile','tab_profile'],['support','tab_support']]; } else { profileTabs=[['profile','tab_profile']]; } profileTabs.forEach(tb=>{ %>
      <% const contextKey = tb[0] === 'refunds' ? 'returns' : tb[0]; const contextCount = (notificationContextCounts||{})[contextKey] || 0; %><a href="/user/profile?tab=<%= tb[0] %>" class="relative whitespace-nowrap rounded-xl px-4 py-3 font-bold <%= (tab||'profile')===tb[0]?'bg-teal-600 text-white':'text-slate-600 hover:bg-slate-100' %>"><%= tb[0] === 'questions' ? 'Vendorlara verdiyim suallar' : t('profile.' + tb[1]) %><% if(contextCount>0){ %><span class="ml-2 inline-grid min-h-5 min-w-5 place-items-center rounded-full bg-rose-600 px-1 text-xs text-white"><%= contextCount %></span><% } %></a>
    <% }) %>
  </nav>

  <% if((tab||'profile')==='profile'){ %>
    <div class="grid gap-6 md:grid-cols-2">
      <section class="rounded-3xl border bg-white p-6">
        <div class="mb-6 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <div class="relative h-28 w-28 shrink-0 overflow-hidden rounded-3xl bg-gradient-to-br from-teal-100 to-emerald-100 ring-4 ring-teal-50">
            <% if(user.profile_picture){ %><img id="avatarPreview" src="<%= user.profile_picture %>" alt="Profil şəkli" class="h-full w-full object-cover">
            <% } else { %><div id="avatarFallback" class="grid h-full w-full place-items-center text-4xl font-black text-teal-700"><%= (user.full_name || 'U').trim().charAt(0).toUpperCase() %></div><img id="avatarPreview" alt="Profil şəkli önizləməsi" class="hidden h-full w-full object-cover"><% } %>
          </div>
          <div class="w-full">
            <p class="font-black text-lg">Profil şəkli</p><p class="mb-3 text-xs text-slate-500">JPG, PNG və ya WEBP · maksimum 5 MB</p>
            <form action="/user/profile/picture" method="POST" enctype="multipart/form-data" class="flex flex-wrap gap-2">
              <label class="cursor-pointer rounded-xl bg-slate-100 px-4 py-2 text-sm font-bold hover:bg-slate-200"><i class="fa-solid fa-image mr-1"></i><%= user.profile_picture ? 'Şəkli dəyiş' : 'Şəkil əlavə et' %><input id="avatarInput" name="profile_picture" type="file" accept="image/jpeg,image/png,image/webp" required class="sr-only"></label>
              <button id="avatarUploadButton" disabled class="rounded-xl bg-teal-600 px-4 py-2 text-sm font-bold text-white hover:bg-teal-700">Yüklə</button>
            </form>
            <% if(user.profile_picture){ %><form action="/user/profile/picture/delete" method="POST" class="mt-2" onsubmit="return confirm('Profil şəklini silmək istədiyinizə əminsiniz?')"><button class="text-sm font-bold text-rose-600 hover:text-rose-800"><i class="fa-solid fa-trash mr-1"></i>Şəkli sil</button></form><% } %>
          </div>
        </div>
        <p><b><%= t('profile.field_name') %></b> <%= user.full_name %></p><p class="mt-2"><b><%= t('profile.field_email') %></b> <%= user.email %></p><p class="mt-2"><b><%= t('profile.field_role') %></b> <%= user.role %></p>
        <form action="/user/profile" method="POST" class="mt-6 space-y-3"><input name="full_name" required value="<%= user.full_name %>" class="w-full rounded-xl bg-slate-100 p-3"><textarea name="bio" rows="3" placeholder="<%= t('profile.bio_placeholder') %>" class="w-full rounded-xl bg-slate-100 p-3"><%= user.bio || '' %></textarea><button class="w-full rounded-xl bg-teal-600 py-3 font-bold text-white"><%= t('profile.save') %></button></form>
      </section>
      <section class="rounded-3xl border bg-white p-6"><h2 class="mb-4 text-xl font-black"><%= t('profile.change_password_title') %></h2><form action="/auth/change-password" method="POST" data-password-policy class="space-y-3"><input type="password" name="currentPassword" placeholder="<%= t('profile.current_password_placeholder') %>" required class="w-full rounded-xl bg-slate-100 p-3"><input type="password" name="newPassword" placeholder="<%= t('profile.new_password_placeholder') %>" minlength="6" maxlength="32" required class="w-full rounded-xl bg-slate-100 p-3"><p class="-mt-1 text-xs text-slate-500">Yeni şifrə 6-32 simvol aralığında olmalı, 1 böyük hərf, 1 kiçik hərf, 1 rəqəm və 1 xüsusi simvol içərməlidir.</p><button class="w-full rounded-xl bg-slate-950 py-3 font-bold text-white"><%= t('profile.change_password_title') %></button></form></section>
    </div>
  <% } else if(tab==='questions'){ %>
    <section class="rounded-3xl border bg-white p-6">
      <h2 class="text-2xl font-black">Vendorlara verdiyim suallar</h2><p class="mb-6 mt-1 text-sm text-slate-500">Məhsullar haqqında verdiyiniz suallar və cavabları.</p>
      <% if(!(questions||[]).length){ %><div class="rounded-2xl bg-slate-50 p-8 text-center text-slate-500"><i class="fa-regular fa-circle-question mb-2 text-3xl"></i><p>Hələ sual verməmisiniz.</p></div><% } %>
      <div class="space-y-4"><% (questions||[]).forEach(q=>{ %>
        <article class="rounded-2xl border border-slate-200 p-5">
          <div class="flex flex-wrap items-start justify-between gap-3"><div><a href="/products/<%= q.product_id %>#qa" class="font-black text-teal-700 hover:underline"><i class="fa-solid fa-box mr-1"></i><%= q.product_name %></a><p class="mt-1 text-sm text-slate-500"><i class="fa-solid fa-store mr-1"></i><%= q.vendor_name %></p></div><span class="rounded-full px-3 py-1 text-xs font-black <%= q.status==='ANSWERED'?'bg-emerald-100 text-emerald-700':q.status==='HANDLED'?'bg-slate-200 text-slate-700':'bg-amber-100 text-amber-800' %>"><%= q.status==='ANSWERED'?'Cavablanıb':q.status==='HANDLED'?'Həll olunub':'Cavab gözləyir' %></span></div>
          <div class="mt-4 rounded-xl bg-slate-50 p-4"><p class="text-xs font-black uppercase tracking-wide text-slate-500">Sualınız</p><p class="mt-1 text-slate-800"><%= q.question_text %></p></div>
          <% if(q.answer_text){ %><div class="mt-3 rounded-xl bg-emerald-50 p-4"><p class="text-xs font-black uppercase tracking-wide text-emerald-700">Cavab</p><p class="mt-1 text-slate-800"><%= q.answer_text %></p></div><% } else { %><p class="mt-3 text-sm text-slate-500">Bu suala hələ cavab verilməyib.</p><% } %>
          <div class="mt-4 flex items-center justify-between gap-3"><span class="text-xs text-slate-400"><%= new Date(q.created_at).toLocaleString(currentLang) %></span><form action="/questions/<%= q._id %>/delete" method="POST" onsubmit="return confirm('Bu sualı silmək istədiyinizə əminsiniz? Sual bütün bölmələrdən silinəcək.')"><button class="text-sm font-bold text-rose-600 hover:text-rose-800"><i class="fa-solid fa-trash mr-1"></i>Sualı sil</button></form></div>
        </article>
      <% }) %></div>
    </section>
  <% } else if(tab==='wallet'){ %>
    <section class="rounded-3xl border bg-white p-6"><h2 class="mb-4 text-2xl font-black"><%= t('profile.wallet_balance_label', { amount: wallet ? Number(wallet.balance).toFixed(2) : 0 }) %></h2><% (walletTransactions||[]).forEach(x=>{ %><div class="border-b py-3"><b><%= x.type %></b> — <%= money(x.amount) %> ₼ <span class="text-sm text-slate-500"><%= new Date(x.created_at).toLocaleString(currentLang) %></span></div><% }) %></section>
  <% } else if(tab==='cards'){ %>
    <section class="rounded-3xl border bg-white p-6"><h2 class="mb-4 text-2xl font-black"><%= t('profile.cards_title') %></h2><% (savedCards||[]).forEach(c=>{ %><div class="flex justify-between border-b py-3"><span><i class="fa-brands fa-cc-<%= c.brand||'visa' %> mr-2"></i><%= c.brand||t('profile.card_fallback') %> •••• <%= c.last4 %></span><form action="/wallet/saved-card/<%= c._id %>/delete" method="POST"><button class="font-bold text-rose-600"><%= t('profile.delete') %></button></form></div><% }) %></section>
  <% } else if(tab==='orders'){ %>
    <section class="rounded-3xl border bg-white p-6"><h2 class="mb-4 text-2xl font-black"><%= t('profile.orders_title') %></h2><% if(!(orders||[]).length){ %><p class="text-slate-500"><%= t('profile.orders_empty') %></p><% } %><% (orders||[]).forEach(o=>{ %><a href="/orders/<%= o._id %>" class="block border-b py-3"><div class="flex justify-between"><span class="font-bold">#<%= o._id.slice(0,8) %></span><span class="font-black"><%= Number(o.total_amount).toFixed(2) %> ₼</span></div><div class="mt-1 flex items-center gap-2 text-sm text-slate-500"><span class="rounded-full bg-slate-100 px-2 py-0.5 font-bold"><%= o.status %></span><span><%= new Date(o.created_at).toLocaleDateString('az-AZ') %></span></div></a><% }) %></section>
  <% } else if(tab==='addresses'){ %>
    <section class="rounded-3xl border bg-white p-6"><h2 class="mb-4 text-2xl font-black"><%= t('profile.addresses_title') %></h2><div class="grid gap-3 sm:grid-cols-2"><% (addresses||[]).forEach(a=>{ %><div class="rounded-2xl border p-4 <%= a.is_default ? 'border-teal-300 bg-teal-50/40' : '' %>"><p class="font-black"><%= a.label || t('profile.address_fallback') %> <% if(a.is_default){ %><span class="text-xs font-bold text-teal-600"><%= t('profile.default_badge') %></span><% } %></p><p class="text-sm"><%= a.full_name %></p><p class="text-sm text-slate-500"><%= a.address_line %>, <%= a.city %></p><p class="text-sm text-slate-500"><%= a.phone %></p><div class="mt-3 flex gap-2"><% if(!a.is_default){ %><form action="/user/address/<%= a._id %>/default" method="POST"><button class="text-xs font-bold text-teal-600"><%= t('profile.set_default') %></button></form><% } %><form action="/user/address/<%= a._id %>/delete" method="POST" onsubmit="return confirm('<%= t('profile.confirm_delete_address') %>')"><button class="text-xs font-bold text-rose-600"><%= t('profile.delete') %></button></form></div></div><% }) %></div><form action="/user/address" method="POST" class="mt-6 grid gap-3 border-t pt-5"><h3 class="font-black"><%= t('profile.new_address_title') %></h3><div class="grid gap-3 sm:grid-cols-2"><input name="label" placeholder="<%= t('profile.label_placeholder') %>" class="rounded-xl bg-slate-100 p-3"><input name="full_name" placeholder="<%= t('profile.fullname_placeholder') %>" class="rounded-xl bg-slate-100 p-3"></div><input name="phone" placeholder="<%= t('profile.phone_placeholder') %>" class="rounded-xl bg-slate-100 p-3"><input name="address_line" placeholder="<%= t('profile.address_placeholder') %>" required class="rounded-xl bg-slate-100 p-3"><input name="city" placeholder="<%= t('profile.city_placeholder') %>" class="rounded-xl bg-slate-100 p-3"><button class="rounded-xl bg-teal-600 py-3 font-bold text-white"><%= t('profile.add') %></button></form></section>
  <% } else if(tab==='reviews'){ %>
    <section class="rounded-3xl border bg-white p-6"><h2 class="mb-4 text-2xl font-black"><%= t('profile.reviews_title') %></h2><% if(!(reviews||[]).length){ %><p class="text-slate-500"><%= t('profile.reviews_empty') %></p><% } %><% (reviews||[]).forEach(r=>{ %><div class="border-b py-3"><div class="text-amber-400"><% for(let i=1;i<=5;i++){ %><i class="fa-star <%= i <= Number(r.rating) ? 'fa-solid' : 'fa-regular' %>"></i><% } %></div><p class="mt-1 font-bold"><%= r.comment || t('profile.no_comment') %></p><p class="text-xs text-slate-500"><%= new Date(r.created_at).toLocaleDateString(currentLang) %> · <%= t('profile.product_label') %> <%= r.product_id %></p><form action="/reviews/<%= r._id %>/delete" method="POST" class="mt-2" onsubmit="return confirm('<%= t('profile.confirm_delete_review') %>')"><button class="text-xs font-bold text-rose-600"><%= t('profile.delete_review') %></button></form></div><% }) %></section>
  <% } else if(tab==='support'){ %>
    <section class="rounded-3xl border bg-white p-6"><h2 class="mb-4 text-2xl font-black"><%= t('profile.support_title') %></h2><% if(!(tickets||[]).length){ %><p class="mb-6 text-slate-500"><%= t('profile.support_empty') %></p><% } %><div class="mb-8 space-y-4"><% (tickets||[]).forEach(tk=>{ %><div class="rounded-2xl border p-4"><div class="mb-2 flex flex-wrap items-center gap-2"><span class="rounded-full px-2 py-1 text-xs font-bold <%= tk.status==='ANSWERED'?'bg-emerald-100 text-emerald-700':tk.status==='CLOSED'?'bg-slate-200 text-slate-600':'bg-amber-100 text-amber-700' %>"><%= tk.status %></span><span class="rounded-full bg-teal-50 px-2 py-1 text-xs font-bold text-teal-700"><%= tk.category %></span></div><div class="mb-3 space-y-2"><% (tk.messages||[]).forEach(m=>{ %><div class="rounded-xl p-3 <%= m.sender==='admin'?'bg-teal-50':'bg-slate-50' %>"><p class="mb-1 text-xs font-bold text-slate-500"><%= m.sender==='admin'?t('profile.sender_admin'):t('profile.sender_you') %> · <%= new Date(m.created_at).toLocaleString(currentLang) %></p><p class="text-sm text-slate-700"><%= m.text %></p></div><% }) %></div><% if(tk.status!=='CLOSED'){ %><form action="/support/<%= tk._id %>/reply" method="POST" class="flex gap-2"><input name="message" required placeholder="<%= t('profile.reply_placeholder') %>" class="min-w-0 flex-1 rounded-xl border px-3 py-2 text-sm"><button class="rounded-xl bg-slate-950 px-4 py-2 text-sm font-bold text-white"><%= t('profile.send') %></button></form><% } %></div><% }) %></div><h3 class="mb-4 border-t pt-6 text-xl font-black"><%= t('profile.new_ticket_title') %></h3><form action="/support" method="POST" class="grid gap-3"><select name="category" class="rounded-xl bg-slate-100 p-3"><option value="ORDER"><%= t('profile.cat_order') %></option><option value="PAYMENT"><%= t('profile.cat_payment') %></option><option value="PRODUCT"><%= t('profile.cat_product') %></option><option value="ACCOUNT"><%= t('profile.cat_account') %></option><option value="OTHER"><%= t('profile.cat_other') %></option></select><input name="orderId" placeholder="<%= t('profile.order_id_placeholder') %>" class="rounded-xl bg-slate-100 p-3"><textarea name="message" required rows="4" placeholder="<%= t('profile.describe_placeholder') %>" class="rounded-xl bg-slate-100 p-3"></textarea><button class="rounded-xl bg-teal-600 py-3 font-bold text-white"><%= t('profile.submit_ticket') %></button></form></section>
  <% } else { %>
    <section class="overflow-x-auto rounded-3xl border bg-white p-6"><table class="w-full min-w-[580px] text-left"><thead><tr><th class="p-3"><%= t('profile.col_date') %></th><th><%= t('profile.col_method') %></th><th><%= t('profile.col_amount') %></th><th><%= t('profile.col_status') %></th></tr></thead><tbody><% ((tab==='payments'?payments:refunds)||[]).forEach(x=>{ %><tr class="border-t"><td class="p-3"><%= new Date(x.created_at||x.date).toLocaleString(currentLang) %></td><td><%= x.payment_method||x.method||x.reason||'—' %></td><td><%= money(x.amount||x.total_amount||0) %> ₼</td><td><%= x.status %></td></tr><% }) %></tbody></table></section>
  <% } %>
</main>
  <%- include('../partials/footer') %>
  <script src="/js/password-policy.js"></script>
<script>
  (function(){
    const input=document.getElementById('avatarInput'), preview=document.getElementById('avatarPreview'), fallback=document.getElementById('avatarFallback'), button=document.getElementById('avatarUploadButton');
    if(!input) return;
    input.addEventListener('change',function(){const file=input.files&&input.files[0];if(!file)return;if(file.size>5*1024*1024){input.value='';alert('Profil şəkli maksimum 5 MB ola bilər.');return;}if(!['image/jpeg','image/png','image/webp'].includes(file.type)){input.value='';alert('Yalnız JPG, PNG və WEBP şəkillərinə icazə verilir.');return;}preview.src=URL.createObjectURL(file);preview.classList.remove('hidden');if(fallback)fallback.classList.add('hidden');button.disabled=false;});
  })();
</script>
</body></html>
