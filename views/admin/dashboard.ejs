<!DOCTYPE html><html lang="<%= currentLang %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Admin Dashboard | ShopNexus</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><script src="https://cdn.jsdelivr.net/npm/chart.js"></script></head><body class="bg-slate-50 text-slate-900"><%- include('../partials/navbar', { user: user || null }) %><div class="flex"><%- include('../partials/admin-sidebar', { current: 'dashboard' }) %><main class="flex-1 p-5 md:p-8 min-w-0"><h1 class="text-3xl font-black mb-8"><%= t('admin_dash.title') %></h1><div class="grid gap-5 sm:grid-cols-2 md:grid-cols-5"><% [["stat_users",users.length,'users','teal',false],["stat_products",products.length,'box','teal',false],["stat_orders",orders.length,'receipt','amber',false],["stat_gmv",Number(gmv || 0).toFixed(2)+' ₼','chart-line','sky',false],["stat_commission",Number(commissionRevenue || 0).toFixed(2)+' ₼','sack-dollar','emerald',true]].forEach(s=>{ %><div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm"><div class="flex justify-between items-center"><p class="text-slate-500 font-bold"><%= t('admin_dash.' + s[0]) %></p><span class="w-10 h-10 rounded-xl bg-<%= s[3] %>-100 text-<%= s[3] %>-600 grid place-items-center"><i class="fa-solid fa-<%= s[2] %>"></i></span></div><h2 class="text-3xl font-black mt-3"><%= s[1] %></h2><% if (s[4]) { %><p class="mt-1 text-xs text-slate-500"><%= t('admin_dash.commission_suffix', { pct: commissionPercent }) %></p><% } %></div><% }) %></div><div class="grid lg:grid-cols-2 gap-6 mt-8"><div class="bg-white rounded-2xl p-5 border"><h2 class="font-black text-lg mb-4"><%= t('admin_dash.chart_revenue_7d') %></h2><canvas id="revenueChart"></canvas></div><div class="bg-white rounded-2xl p-5 border"><h2 class="font-black text-lg mb-4"><%= t('admin_dash.chart_category') %></h2><canvas id="categoryChart"></canvas></div><div class="bg-white rounded-2xl p-5 border lg:col-span-2"><h2 class="font-black text-lg mb-4"><%= t('admin_dash.chart_top_products') %></h2><canvas id="topProductsChart"></canvas></div></div><div class="grid lg:grid-cols-2 gap-6 mt-8"><section class="bg-white rounded-2xl border overflow-hidden"><h2 class="font-black text-lg p-5"><%= t('admin_dash.chart_top_products') %></h2><div class="overflow-x-auto"><table class="w-full min-w-[560px] text-left"><thead class="bg-slate-50 text-slate-500 text-sm"><tr><th class="p-4"><%= t('admin_dash.col_product') %></th><th class="p-4"><%= t('admin_dash.col_sales') %></th></tr></thead><tbody><% (topProductsLabels || []).forEach((label,i)=>{ %><tr class="border-t"><td class="p-4 font-bold"><%= label %></td><td class="p-4"><%= (topProductsData || [])[i] || 0 %></td></tr><% }) %></tbody></table></div></section><section class="bg-white rounded-2xl border overflow-hidden"><h2 class="font-black text-lg p-5"><%= t('admin_dash.top_customers_title') %></h2><div class="overflow-x-auto"><table class="w-full min-w-[560px] text-left"><thead class="bg-slate-50 text-slate-500 text-sm"><tr><th class="p-4"><%= t('admin_dash.col_customer') %></th><th class="p-4"><%= t('admin_dash.col_email') %></th><th class="p-4"><%= t('admin_dash.col_orders') %></th></tr></thead><tbody><% (topCustomers || []).forEach(c=>{ %><tr class="border-t"><td class="p-4 font-bold"><%= c.full_name %></td><td class="p-4"><%= c.email %></td><td class="p-4"><%= c.orderCount %></td></tr><% }) %></tbody></table></div></section></div></main></div><%- include('../partials/footer') %><script>const revenueLabels=<%- JSON.stringify(revenueLabels || []) %>, revenueData=<%- JSON.stringify(revenueData || []) %>, categoryLabels=<%- JSON.stringify(categoryLabels || []) %>, categoryData=<%- JSON.stringify(categoryData || []) %>, topProductsLabels=<%- JSON.stringify(topProductsLabels || []) %>, topProductsData=<%- JSON.stringify(topProductsData || []) %>, revenueLabel=<%- JSON.stringify(t('admin_dash.chart_revenue_label')) %>, salesLabel=<%- JSON.stringify(t('admin_dash.chart_sales_label')) %>;new Chart(document.getElementById('revenueChart'),{type:'line',data:{labels:revenueLabels,datasets:[{label:revenueLabel,data:revenueData,borderColor:'#0d9488',backgroundColor:'#ccfbf1',fill:true,tension:.35}]},options:{responsive:true}});new Chart(document.getElementById('categoryChart'),{type:'doughnut',data:{labels:categoryLabels,datasets:[{data:categoryData,backgroundColor:['#0d9488','#059669','#0891b2','#059669','#f59e0b','#e11d48']}]},options:{responsive:true}});new Chart(document.getElementById('topProductsChart'),{type:'bar',data:{labels:topProductsLabels,datasets:[{label:salesLabel,data:topProductsData,backgroundColor:'#14b8a6',borderRadius:8}]},options:{responsive:true,scales:{y:{beginAtZero:true}}}});</script></body></html>
