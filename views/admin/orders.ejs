<!DOCTYPE html><html lang="<%= currentLang %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= t('admin_orders.title') %></title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-50 text-slate-900"><%- include('../partials/navbar',{user:user||null}) %><div class="flex"><%- include('../partials/admin-sidebar',{current:'orders'}) %><main class="flex-1 p-5 md:p-8 min-w-0"><h1 class="text-3xl font-black mb-7"><%= t('admin_orders.title') %></h1><form action="/admin/orders" method="GET" class="bg-white border rounded-2xl p-4 mb-6 flex flex-wrap gap-3"><select name="status" class="rounded-xl border px-4 py-2"><option value=""><%= t('admin_orders.status_all') %></option><% ['PENDING_PAYMENT','PAID','PROCESSING','SHIPPED','DELIVERED','CANCELLED','RETURN_REQUESTED','RETURNED','REFUNDED'].forEach(s=>{ %><option <%= query&&query.status===s?'selected':'' %>><%= s %></option><% }) %></select><input name="search" value="<%= query&&query.search||'' %>" placeholder="<%= t('admin_orders.search_placeholder') %>" class="rounded-xl border px-4 py-2 flex-1 min-w-48"><input name="date" type="date" value="<%= query&&query.date||'' %>" class="rounded-xl border px-4 py-2"><button class="rounded-xl bg-teal-600 text-white px-5 py-2 font-bold"><%= t('admin_orders.apply_button') %></button></form><div class="bg-white rounded-2xl border overflow-x-auto"><table class="w-full text-left min-w-[850px]"><thead class="bg-slate-50 text-slate-500 text-sm"><tr><th class="p-4"><%= t('admin_orders.col_order_id') %></th><th><%= t('admin_orders.col_customer') %></th><th><%= t('admin_orders.col_total') %></th><th><%= t('admin_orders.col_status') %></th><th><%= t('admin_orders.col_date') %></th><th><%= t('admin_orders.col_change_status') %></th></tr></thead><tbody><% orders.forEach(o=>{ %><tr class="border-t"><td class="p-4 font-bold"><%= o._id %></td><td><%= o.customer_name || o.user_id || '—' %></td><td><%= money(o.total_amount) %> ₼</td><td><span class="px-2 py-1 rounded-full bg-teal-100 text-teal-700 text-xs font-bold"><%= o.status %></span></td><td><%= o.created_at ? new Date(o.created_at).toLocaleDateString(dateLocale) : '—' %></td><td><form action="/admin/orders/<%= o._id %>/status" method="POST" class="flex gap-2"><select name="status" class="border rounded-lg px-2 py-1"><% ['PENDING_PAYMENT','PAID','PROCESSING','SHIPPED','DELIVERED','CANCELLED','RETURN_REQUESTED','RETURNED','REFUNDED'].forEach(s=>{ %><option <%= o.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="text-teal-600 font-bold"><%= t('admin_orders.update_button') %></button></form></td></tr><% }) %></tbody></table></div></main></div><%- include('../partials/footer') %></body></html>
