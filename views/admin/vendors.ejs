<!DOCTYPE html><html lang="az"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Satıcılar</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-50 text-slate-900"><%- include('../partials/navbar', { user: user || null }) %><div class="flex"><%- include('../partials/admin-sidebar',{current:'vendors'}) %><main class="flex-1 p-5 md:p-8 min-w-0"><h1 class="text-3xl font-black mb-7">Satıcılar</h1><div class="bg-white rounded-2xl border overflow-x-auto"><table class="w-full text-left min-w-[900px]"><thead class="bg-slate-50 text-slate-500 text-sm"><tr><th class="p-4">Mağaza</th><th>Sahib</th><th>Məhsul sayı</th><th>Status</th><th>Qeydiyyat</th><th>Əməliyyatlar</th></tr></thead><tbody><% if(!vendorRows.length){ %><tr><td colspan="6" class="p-6 text-center text-slate-400">Hələ satıcı yoxdur.</td></tr><% } %><% vendorRows.forEach(row=>{ const v=row.vendor; const status = v.status || 'ACTIVE'; %><tr class="border-t align-top"><td class="p-4 font-bold flex items-center gap-3"><% if(v.store_logo){ %><img src="<%= v.store_logo %>" class="h-10 w-10 rounded-xl object-cover"><% } %><%= v.store_name %></td><td class="p-4"><%= row.owner ? row.owner.full_name : '—' %><br><span class="text-xs text-slate-400"><%= row.owner ? row.owner.email : '' %></span></td><td class="p-4"><%= row.productCount %></td><td class="p-4"><span class="px-2 py-1 rounded-full text-xs font-bold <%= status==='SUSPENDED'?'bg-rose-100 text-rose-700':'bg-emerald-100 text-emerald-700' %>"><%= status==='SUSPENDED'?'Dayandırılıb':'Aktiv' %></span></td><td class="p-4"><%= v.created_at ? new Date(v.created_at).toLocaleDateString('az-AZ') : '—' %></td><td class="p-4"><a href="/admin/vendors/<%= v._id %>" class="text-teal-600 font-bold text-sm">Ətraflı bax</a></td></tr><% }) %></tbody></table></div></main></div><%- include('../partials/footer') %></body></html>
