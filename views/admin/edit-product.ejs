<!DOCTYPE html><html lang="az"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Məhsulu redaktə et</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-50 text-slate-900"><%- include('../partials/navbar',{user:user||null}) %><div class="flex"><%- include('../partials/admin-sidebar',{current:'products'}) %><main class="flex-1 p-5 md:p-8"><h1 class="text-3xl font-black mb-7">Məhsulu redaktə et</h1><form action="/admin/products/<%= product._id %>" method="POST" class="bg-white border rounded-2xl p-6 max-w-3xl grid md:grid-cols-2 gap-5"><label class="font-bold">Ad<input name="name" required value="<%= product.name %>" class="mt-2 w-full rounded-xl border px-4 py-3 font-normal"></label><label class="font-bold">Qiymət<input name="price" required type="number" step="0.01" value="<%= product.price %>" class="mt-2 w-full rounded-xl border px-4 py-3 font-normal"></label><label class="font-bold">Stok<input name="stock_quantity" required type="number" value="<%= product.stock_quantity %>" class="mt-2 w-full rounded-xl border px-4 py-3 font-normal"></label><label class="font-bold">Kateqoriya<select name="category" class="mt-2 w-full rounded-xl border px-4 py-3 font-normal"><% categories.forEach(c=>{ %><option value="<%= c.name %>" <%= product.category===c.name?'selected':'' %>><%= c.name %></option><% }) %></select></label><label class="font-bold md:col-span-2">Təsvir<textarea name="description" rows="4" class="mt-2 w-full rounded-xl border px-4 py-3 font-normal"><%= product.description || '' %></textarea></label><label class="font-bold md:col-span-2">Şəkil URL<input name="image_url" value="<%= product.image_url || '' %>" class="mt-2 w-full rounded-xl border px-4 py-3 font-normal"></label><button class="md:col-span-2 rounded-xl bg-teal-600 text-white px-5 py-3 font-bold">Yadda saxla</button></form></main></div><%- include('../partials/footer') %></body></html>