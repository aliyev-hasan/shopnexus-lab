<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin_coupons.title') %></title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-900">
  <%- include('../partials/navbar',{user:user||null}) %>
  <div class="flex"><%- include('../partials/admin-sidebar',{current:'coupons'}) %><main class="flex-1 p-5 md:p-8 min-w-0">
    <h1 class="text-3xl font-black mb-7"><%= t('admin_coupons.title') %></h1>
    <form action="/admin/coupons" method="POST" data-coupon-form class="bg-white border rounded-2xl p-5 mb-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <input name="code" required placeholder="<%= t('admin_coupons.code_placeholder') %>" class="rounded-xl border px-3 py-2">
      <select name="discount_type" class="rounded-xl border px-3 py-2"><option value="percentage"><%= t('admin_coupons.type_percentage') %></option><option value="fixed"><%= t('admin_coupons.type_fixed') %></option><option value="free_shipping"><%= t('admin_coupons.type_free_shipping') %></option><option value="first_order"><%= t('admin_coupons.type_first_order') %></option></select>
      <input name="discount_value" required type="number" step="0.01" min="1" max="100" placeholder="<%= t('admin_coupons.value_placeholder') %>" class="rounded-xl border px-3 py-2">
      <input name="usage_limit" required type="number" step="1" min="1" max="1000" value="1000" aria-label="İstifadə limiti" class="rounded-xl border px-3 py-2">
      <input name="min_order_value" type="number" step="0.01" min="0" placeholder="<%= t('admin_coupons.min_order_placeholder') %>" class="rounded-xl border px-3 py-2">
      <input name="expiry_date" type="date" class="rounded-xl border px-3 py-2">
      <select name="vendor_id" class="rounded-xl border px-3 py-2"><option value=""><%= t('admin_coupons.all_vendors_option') %></option><% (vendors||[]).forEach(v=>{ %><option value="<%= v._id %>"><%= v.store_name %> <%= t('admin_coupons.vendor_only_suffix') %></option><% }) %></select>
      <button class="rounded-xl bg-teal-600 text-white px-5 py-3 font-bold"><%= t('admin_coupons.create_button') %></button>
    </form>
    <div class="bg-white rounded-2xl border overflow-x-auto"><table class="w-full text-left min-w-[1050px]">
      <thead class="bg-slate-50 text-slate-500"><tr><th class="p-4"><%= t('admin_coupons.col_code') %></th><th><%= t('admin_coupons.col_type') %></th><th><%= t('admin_coupons.col_value') %></th><th>İstifadə limiti</th><th><%= t('admin_coupons.col_min_order') %></th><th><%= t('admin_coupons.col_expiry') %></th><th><%= t('admin_coupons.col_scope') %></th><th><%= t('admin_coupons.col_actions') %></th></tr></thead>
      <tbody><% coupons.forEach(c=>{ %><tr class="border-t"><td colspan="8" class="p-4">
        <div class="mb-2"><span class="inline-block rounded-full px-3 py-1 text-xs font-bold <%= c.vendor_id ? 'bg-amber-100 text-amber-700' : 'bg-teal-100 text-teal-700' %>"><%= c.vendor_id ? (t('admin_coupons.vendor_scope_prefix') + ' ' + ((vendorsById[c.vendor_id] && vendorsById[c.vendor_id].store_name) || t('admin_coupons.deleted_vendor'))) : t('admin_coupons.global_scope') %></span></div>
        <form action="/admin/coupons/<%= c._id %>" method="POST" data-coupon-form class="flex flex-wrap gap-2 items-center">
          <input name="code" required value="<%= c.code %>" class="border rounded-lg px-2 py-1 font-bold w-28">
          <select name="discount_type" class="border rounded-lg px-2 py-1"><option value="percentage" <%= c.discount_type==='percentage'?'selected':'' %>><%= t('admin_coupons.type_percentage') %></option><option value="fixed" <%= c.discount_type==='fixed'?'selected':'' %>><%= t('admin_coupons.type_fixed') %></option></select>
          <input name="discount_value" required value="<%= c.discount_value %>" type="number" step="0.01" class="border rounded-lg px-2 py-1 w-24">
          <input name="usage_limit" required value="<%= c.usage_limit || 1000 %>" type="number" step="1" min="1" max="1000" class="border rounded-lg px-2 py-1 w-24" aria-label="İstifadə limiti">
          <input name="min_order_value" value="<%= c.min_order_value || '' %>" type="number" step="0.01" min="0" class="border rounded-lg px-2 py-1 w-28">
          <input name="expiry_date" value="<%= c.expiry_date ? String(c.expiry_date).slice(0,10) : '' %>" type="date" class="border rounded-lg px-2 py-1">
          <select name="vendor_id" class="border rounded-lg px-2 py-1"><option value=""><%= t('admin_coupons.global_scope') %></option><% (vendors||[]).forEach(v=>{ %><option value="<%= v._id %>" <%= c.vendor_id===v.user_id?'selected':'' %>><%= v.store_name %></option><% }) %></select>
          <button class="text-teal-600 font-bold"><%= t('admin_coupons.save') %></button>
        </form>
        <p class="mt-2 text-xs text-slate-500"><%= c.used_count || 0 %> dəfə istifadə olunub</p>
        <form action="/admin/coupons/<%= c._id %>/delete" method="POST" class="mt-2" onsubmit="return confirm('<%= t('admin_coupons.confirm_delete') %>')"><button class="text-rose-600 font-bold text-sm"><%= t('admin_coupons.delete') %></button></form>
      </td></tr><% }) %></tbody>
    </table></div>
  </main></div>
  <%- include('../partials/footer') %><script src="/js/coupon-validation.js"></script>
</body></html>
