<!DOCTYPE html><html lang="<%= currentLang %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= t('admin_products.title') %></title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-50 text-slate-900"><%- include('../partials/navbar',{user:user||null}) %><div class="flex"><%- include('../partials/admin-sidebar',{current:'products'}) %><main class="flex-1 p-5 md:p-8 min-w-0"><div class="flex flex-wrap justify-between gap-4 mb-7"><h1 class="text-3xl font-black"><%= t('admin_products.title') %></h1><form action="/admin/products" method="GET"><select name="category" onchange="this.form.submit()" class="rounded-xl border bg-white px-4 py-2"><option value=""><%= t('admin_products.all_categories') %></option><% (categories||[]).forEach(c=>{ %><option value="<%= c._id || c.name %>" <%= query && query.category===(c._id||c.name)?'selected':'' %>><%= c.name %></option><% }) %></select></form></div><div class="bg-white rounded-2xl border overflow-x-auto"><table class="w-full text-left min-w-[800px]"><thead class="bg-slate-50 text-slate-500 text-sm"><tr><th class="p-4"><%= t('admin_products.col_product') %></th><th><%= t('admin_products.col_vendor') %></th><th><%= t('admin_products.col_category') %></th><th><%= t('admin_products.col_price') %></th><th><%= t('admin_products.col_stock') %></th><th><%= t('admin_products.col_actions') %></th></tr></thead><tbody><% products.forEach(p=>{ %><tr class="border-t"><td class="p-4 font-bold"><%= p.name %></td><td><%= p.vendor_name || p.vendor_id || '—' %></td><td><%= p.category_name || p.category || '—' %></td><td><%= money(p.price) %> ₼</td><td><%= p.stock_quantity %></td><td class="p-4 flex gap-3"><a href="/admin/products/<%= p._id %>/edit" class="text-teal-600 font-bold"><%= t('admin_products.edit') %></a><form action="/admin/products/<%= p._id %>/delete" method="POST" onsubmit="return confirm('<%= t('admin_products.confirm_delete') %>')"><button class="text-rose-600 font-bold"><%= t('admin_products.delete') %></button></form></td></tr><% }) %></tbody></table></div></main></div><%- include('../partials/footer') %></body></html>
