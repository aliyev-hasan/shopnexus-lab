<!DOCTYPE html><html lang="<%= currentLang %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= t('admin_categories.title') %></title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-50 text-slate-900"><%- include('../partials/navbar',{user:user||null}) %><div class="flex"><%- include('../partials/admin-sidebar',{current:'categories'}) %><main class="flex-1 p-5 md:p-8"><h1 class="text-3xl font-black mb-7"><%= t('admin_categories.title') %></h1><form action="/admin/categories" method="POST" class="bg-white border rounded-2xl p-5 mb-6 grid md:grid-cols-[1fr_2fr_auto] gap-3"><input name="name" required placeholder="<%= t('admin_categories.name_placeholder') %>" class="rounded-xl border px-4 py-3"><input name="description" placeholder="<%= t('admin_categories.description_placeholder') %>" class="rounded-xl border px-4 py-3"><button class="rounded-xl bg-teal-600 text-white px-5 py-3 font-bold"><%= t('admin_categories.create_button') %></button></form><div class="bg-white rounded-2xl border overflow-x-auto"><table class="w-full text-left min-w-[700px]"><thead class="bg-slate-50 text-slate-500"><tr><th class="p-4"><%= t('admin_categories.col_name') %></th><th><%= t('admin_categories.col_description') %></th><th><%= t('admin_categories.col_action') %></th></tr></thead><tbody><% categories.forEach(c=>{ %><tr class="border-t"><td colspan="3" class="p-4"><form action="/admin/categories/<%= c._id %>" method="POST" class="flex flex-wrap gap-3"><input name="name" required value="<%= c.name %>" class="rounded-lg border px-3 py-2 font-bold flex-1 min-w-40"><input name="description" value="<%= c.description || '' %>" class="rounded-lg border px-3 py-2 flex-[2] min-w-48"><button class="text-teal-600 font-bold"><%= t('admin_categories.save') %></button></form><form action="/admin/categories/<%= c._id %>/delete" method="POST" class="mt-2" onsubmit="return confirm('<%= t('admin_categories.confirm_delete') %>')"><button class="text-rose-600 font-bold text-sm"><%= t('admin_categories.delete') %></button></form></td></tr><% }) %></tbody></table></div></main></div><%- include('../partials/footer') %></body></html>
