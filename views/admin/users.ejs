<!DOCTYPE html><html lang="az"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>İstifadəçilər</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-50 text-slate-900"><%- include('../partials/navbar', { user: user || null }) %><div class="flex"><%- include('../partials/admin-sidebar',{current:'users'}) %><main class="flex-1 p-5 md:p-8 min-w-0"><h1 class="text-3xl font-black mb-7">İstifadəçilər</h1><form action="/admin/users" method="POST" data-password-policy class="bg-white border rounded-2xl p-5 mb-6 grid sm:grid-cols-2 lg:grid-cols-6 gap-3"><input name="full_name" required placeholder="Ad Soyad" class="rounded-xl border px-3 py-2"><input name="email" type="email" required placeholder="Email" class="rounded-xl border px-3 py-2"><input name="password" type="password" required minlength="6" maxlength="32" placeholder="Şifrə (6-32 simvol)" class="rounded-xl border px-3 py-2"><span class="text-[10px] text-slate-400 lg:col-span-6 -mt-2">Şifrə 6-32 simvol aralığında olmalı, 1 böyük hərf, 1 kiçik hərf, 1 rəqəm və 1 xüsusi simvol içərməlidir.</span><select name="role" id="createUserRole" class="rounded-xl border px-3 py-2" onchange="document.getElementById('createUserStoreName').classList.toggle('hidden', this.value!=='Vendor')"><option value="Customer">Müştəri</option><option value="Vendor">Satıcı</option><option value="Admin">Admin</option></select><input id="createUserStoreName" name="store_name" placeholder="Mağaza adı (Satıcı üçün)" class="rounded-xl border px-3 py-2 hidden"><button class="rounded-xl bg-teal-600 text-white px-5 py-2 font-bold">Yeni istifadəçi yarat</button></form><form action="/admin/users" method="GET" class="bg-white border rounded-2xl p-4 mb-6 flex flex-wrap gap-3"><input name="search" value="<%= query && query.search || '' %>" placeholder="Ad və ya email axtar..." class="rounded-xl border px-4 py-2 flex-1 min-w-48"><select name="role" class="rounded-xl border px-4 py-2"><option value="">Hamısı</option><% ['Customer','Vendor','Admin'].forEach(r=>{ %><option value="<%= r %>" <%= query && query.role===r?'selected':'' %>><%= r %></option><% }) %></select><button class="rounded-xl bg-teal-600 text-white px-5 py-2 font-bold">Tətbiq et</button></form><div class="bg-white rounded-2xl border overflow-x-auto"><table class="w-full text-left min-w-[1000px]"><thead class="bg-slate-50 text-slate-500 text-sm"><tr><th class="p-4">Ad</th><th>Email</th><th>Rol</th><th>Status</th><th>Qeydiyyat</th><th>Əməliyyatlar</th></tr></thead><tbody><% users.forEach(u=>{ const active=u.isActive===undefined?true:u.isActive; %><tr class="border-t align-top"><td class="p-4 font-bold"><%= u.full_name %></td><td class="p-4"><%= u.email %></td><td class="p-4"><form action="/admin/users/<%= u._id %>/role" method="POST" class="flex gap-2"><select name="role" class="border rounded-lg px-2 py-1"><% ['Customer','Vendor','Admin'].forEach(r=>{ %><option <%= u.role===r?'selected':'' %>><%= r %></option><% }) %></select><button class="text-teal-600 font-bold text-sm">Rol dəyiş</button></form></td><td class="p-4"><span class="px-2 py-1 rounded-full text-xs font-bold <%= active?'bg-emerald-100 text-emerald-700':'bg-rose-100 text-rose-700' %>"><%= active?'Aktiv':'Bloklanıb' %></span></td><td class="p-4"><%= u.created_at ? new Date(u.created_at).toLocaleDateString('az-AZ') : '—' %></td><td class="p-4 space-y-2"><form action="/admin/users/<%= u._id %>/toggle-active" method="POST"><button class="text-sm font-bold <%= active?'text-rose-600':'text-emerald-600' %>"><%= active?'Blokla':'Aktivləşdir' %></button></form><form action="/admin/users/<%= u._id %>/reset-password" method="POST" data-password-policy class="flex gap-2"><input name="newPassword" required minlength="6" maxlength="32" placeholder="Yeni şifrə" class="border rounded-lg px-2 py-1 text-sm"><button class="text-teal-600 text-sm font-bold">Reset</button></form></td></tr><% }) %></tbody></table></div></main></div><%- include('../partials/footer') %><script src="/js/password-policy.js"></script></body></html>