<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gift Card-lar | ShopNexus</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
  <%- include('../partials/navbar', { user: user || null }) %>
  <div class="flex">
    <%- include('../partials/admin-sidebar', { current: 'giftcards' }) %>
    <main class="min-w-0 flex-1 p-5 md:p-8">
      <div class="mx-auto max-w-4xl">
        <div class="mb-8">
          <p class="text-sm font-black uppercase tracking-wider text-teal-600">Admin paneli</p>
          <h1 class="mt-1 text-3xl font-black">Gift Card-lar</h1>
        </div>
        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 mb-6">
          <h2 class="mb-4 text-xl font-black">Yeni gift card yarat</h2>
          <form action="/admin/giftcards" method="POST" class="flex flex-col sm:flex-row gap-3">
            <input name="balance" type="number" step="0.01" min="0.01" required placeholder="Balans (₼)" class="flex-1 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-bold outline-none focus:border-teal-400">
            <button type="submit" class="rounded-2xl bg-teal-600 px-6 py-3 font-black text-white transition hover:bg-teal-700"><i class="fa-solid fa-gift mr-2"></i>Yarat</button>
          </form>
        </section>
        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="mb-4 text-xl font-black">Bütün gift card-lar</h2>
          <% if (!giftCards.length) { %>
            <div class="rounded-2xl bg-slate-50 border border-slate-100 p-8 text-center text-slate-500 font-bold">Hələ gift card yoxdur.</div>
          <% } else { %>
            <div class="overflow-x-auto">
              <table class="w-full text-left min-w-[600px]">
                <thead class="bg-slate-50 text-slate-500 text-sm">
                  <tr><th class="p-4">Kod</th><th>Balans</th><th>Status</th><th>Tarix</th><th>Əməliyyat</th></tr>
                </thead>
                <tbody>
                  <% giftCards.forEach(g => { %>
                    <tr class="border-t">
                      <td class="p-4 font-mono font-bold"><%= g.code %></td>
                      <td><%= Number(g.balance).toFixed(2) %> ₼</td>
                      <td><span class="px-2 py-1 rounded-full text-xs font-bold <%= g.is_active ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-500' %>"><%= g.is_active ? 'Aktiv' : 'İstifadə olunub' %></span></td>
                      <td><%= g.created_at ? new Date(g.created_at).toLocaleDateString('az-AZ') : '—' %></td>
                      <td><form action="/admin/giftcards/<%= g._id %>/delete" method="POST"><button type="submit" class="text-rose-600 font-bold">Sil</button></form></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>
      </div>
    </main>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>
