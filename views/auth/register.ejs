<!DOCTYPE html>
<html lang="az">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Qeydiyyat</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body class="bg-slate-50 text-slate-900">
  <%- include('../partials/navbar', { user: user || null }) %>
  <main class="min-h-[70vh] grid place-items-center px-4 py-12"><div class="w-full max-w-lg bg-white rounded-[2rem] p-8 shadow-xl border border-slate-200"><p class="text-sm font-black uppercase tracking-wider text-teal-700"><%= portalRole %> qeydiyyatı</p><h1 class="mt-1 text-3xl font-black"><%= portalRole==='Vendor'?'Satıcı hesabı yarat':'ShopNexus müştəri hesabı yarat' %></h1><form action="<%= authPaths.register %>" method="POST" data-password-policy class="mt-6 space-y-4"><input class="w-full rounded-2xl bg-slate-100 p-4" type="text" name="full_name" placeholder="Ad Soyad" autocomplete="name" required><input class="w-full rounded-2xl bg-slate-100 p-4" type="email" name="email" placeholder="Email" autocomplete="email" required><input class="w-full rounded-2xl bg-slate-100 p-4" type="password" name="password" minlength="6" maxlength="32" placeholder="Şifrə" autocomplete="new-password" required><p class="-mt-2 text-xs text-slate-500">Şifrə 6-32 simvol aralığında olmalı, 1 böyük hərf, 1 kiçik hərf, 1 rəqəm və 1 xüsusi simvol içərməlidir.</p><button class="w-full rounded-2xl bg-teal-600 text-white py-4 font-black">Qeydiyyat</button></form><p class="mt-5 text-center">Artıq hesabınız var? <a class="text-teal-600 font-bold" href="<%= authPaths.login %>">Giriş</a></p></div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/password-policy.js"></script>
</body>
</html>
