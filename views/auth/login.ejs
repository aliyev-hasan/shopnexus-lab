<!DOCTYPE html>
<html lang="az">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Giriş</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body class="bg-slate-50 text-slate-900">
  <%- include('../partials/navbar', { user: user || null }) %>
  <main class="min-h-[70vh] grid place-items-center px-4 py-12"><div class="w-full max-w-md bg-white rounded-[2rem] p-8 shadow-xl border border-slate-200"><div class="w-16 h-16 rounded-3xl <%= portalRole==='Admin'?'bg-slate-950':portalRole==='Vendor'?'bg-amber-500':'bg-teal-600' %> text-white grid place-items-center text-2xl mb-5"><i class="fa-solid <%= portalRole==='Admin'?'fa-user-shield':portalRole==='Vendor'?'fa-store':'fa-user' %>"></i></div><p class="text-sm font-black uppercase tracking-wider text-teal-700"><%= portalRole %> portalı</p><h1 class="mt-1 text-3xl font-black">Hesabınıza daxil olun</h1><p class="text-slate-500 mt-2"><%= portalRole==='Admin'?'Yalnız Admin hesabları':portalRole==='Vendor'?'Yalnız Vendor hesabları':'Yalnız Müştəri hesabları' %></p><form action="<%= authPaths.login %>" method="POST" class="mt-6 space-y-4"><input class="w-full rounded-2xl bg-slate-100 p-4 outline-none focus:ring-2 focus:ring-teal-500" type="email" name="email" placeholder="Email" autocomplete="email" required><input class="w-full rounded-2xl bg-slate-100 p-4 outline-none focus:ring-2 focus:ring-teal-500" type="password" name="password" placeholder="Şifrə" autocomplete="current-password" required><button class="w-full rounded-2xl bg-slate-950 text-white py-4 font-black hover:bg-teal-600">Giriş</button></form><% if(authPaths.register){ %><p class="mt-5 text-center text-slate-600">Hesabınız yoxdur? <a class="text-teal-600 font-bold" href="<%= authPaths.register %>">Qeydiyyat</a></p><% } %></div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
