<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('order.my_orders') %> | ShopNexus</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-900">
  <%- include('../partials/navbar', { user: user || null }) %>
  <main class="max-w-5xl mx-auto px-4 py-10">
    <h1 class="text-4xl font-black mb-8"><%= t('order.my_orders') %></h1>

    <div class="mb-6 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <div class="relative flex-1">
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input id="orderSearchInput" type="text" autocomplete="off"
                 placeholder="Sifarişlərdə axtarın..."
                 class="w-full rounded-2xl border border-slate-200 bg-slate-50 py-3 pl-11 pr-4 outline-none focus:border-teal-500 focus:bg-white focus:ring-4 focus:ring-teal-500/10">
        </div>
        <button id="btnSearchOrders" type="button"
                class="inline-flex items-center justify-center gap-2 rounded-2xl bg-slate-950 px-6 py-3 font-black text-white transition hover:bg-teal-600 disabled:opacity-50">
          <i class="fa-solid fa-magnifying-glass"></i> Axtar
        </button>
      </div>
    </div>

    <div id="ordersList">
      <% if(!orders.length){ %>
        <div class="bg-white rounded-3xl p-10 text-center"><%= t('order.empty') %> <a class="text-teal-600 font-bold" href="/products"><%= t('order.browse_products') %></a></div>
      <% } else { %>
        <div class="space-y-4">
          <% orders.forEach(o=>{ %>
            <% const miniSteps = ['PENDING_PAYMENT','PAID','PROCESSING','SHIPPED','DELIVERED']; const miniIdx = miniSteps.indexOf(o.status); %>
            <a href="/orders/<%= o._id %>" class="block rounded-3xl border bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-md">
              <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
                <div>
                  <p class="break-all text-xl font-black">#<%= o._id.slice(0,8) %></p>
                  <p class="text-slate-500"><%= new Date(o.created_at).toLocaleString('az-AZ') %></p>
                </div>
                <div class="text-left sm:text-right">
                  <p class="text-2xl font-black"><%= Number(o.total_amount).toFixed(2) %> ₼</p>
                  <span class="inline-block rounded-full bg-teal-100 px-3 py-1 text-sm font-bold text-teal-700"><%= t('order.status.' + o.status) %></span>
                </div>
              </div>
              <% if(!['CANCELLED','REFUNDED','RETURN_REQUESTED','RETURNED'].includes(o.status)){ %>
                <div class="mt-5">
                  <div class="flex h-2 gap-1 overflow-hidden rounded-full bg-slate-100">
                    <% miniSteps.forEach((s,i)=>{ %>
                      <span class="flex-1 rounded-full <%= i <= miniIdx ? 'bg-emerald-500' : 'bg-slate-200' %>"></span>
                    <% }) %>
                  </div>
                  <div class="mt-2 flex justify-between text-[10px] font-bold text-slate-400">
                    <span><%= t('order.mini_pending') %></span><span><%= t('order.mini_paid') %></span><span><%= t('order.mini_processing') %></span><span><%= t('order.mini_shipped') %></span><span><%= t('order.mini_delivered') %></span>
                  </div>
                </div>
              <% } %>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script>
    (function(){
      var input = document.getElementById('orderSearchInput');
      var btn = document.getElementById('btnSearchOrders');
      var list = document.getElementById('ordersList');
      if (!input || !btn || !list) return;

      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function escapeRegex(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

      function renderOrders(orders) {
        if (!orders || !orders.length) {
          list.innerHTML = '<div class="bg-white rounded-3xl p-10 text-center text-slate-500 font-bold">Heç bir sifariş tapılmadı.</div>';
          return;
        }
        list.innerHTML = '<div class="space-y-4">' + orders.map(function (o) {
          var id = String(o._id || '');
          var amount = Number(o.total_amount || 0).toFixed(2);
          var date = o.created_at ? new Date(o.created_at).toLocaleString('az-AZ') : '';
          var status = esc(o.status || '');
          return '<a href="/orders/' + esc(id) + '" class="block rounded-3xl border bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-md">' +
            '<div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">' +
              '<div><p class="break-all text-xl font-black">#' + esc(String(id).slice(0, 8)) + '</p><p class="text-slate-500">' + esc(date) + '</p></div>' +
              '<div class="text-left sm:text-right"><p class="text-2xl font-black">' + amount + ' ₼</p>' +
              '<span class="inline-block rounded-full bg-teal-100 px-3 py-1 text-sm font-bold text-teal-700">' + status + '</span></div>' +
            '</div></a>';
        }).join('') + '</div>';
      }

      function doSearch() {
        var val = input.value.trim();
        var payload;
        try {
          var parsed = JSON.parse(val);
          payload = parsed && typeof parsed === 'object' && parsed.filter ? parsed : { filter: parsed };
        } catch (e) {
          payload = { filter: { _id: { $regex: escapeRegex(val), $options: 'i' } } };
        }
        btn.disabled = true;
        fetch('/orders/search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
          .then(function (res) {
            if (res.data && res.data.success) { renderOrders(res.data.data); }
            else { list.innerHTML = '<div class="bg-white rounded-3xl p-10 text-center text-rose-600 font-bold">' + esc((res.data && res.data.error) || 'Axtarış xətası.') + '</div>'; }
          })
          .catch(function () { list.innerHTML = '<div class="bg-white rounded-3xl p-10 text-center text-rose-600 font-bold">Sorğu emal edilə bilmədi.</div>'; })
          .finally(function () { btn.disabled = false; });
      }

      btn.addEventListener('click', doSearch);
      input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); doSearch(); } });
    })();
  </script>
</body>
</html>
