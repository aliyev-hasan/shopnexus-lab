<!DOCTYPE html><html lang="az"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Qəbz | ShopNexus</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"><style>@media print{body{background:#fff!important}.no-print{display:none!important}.receipt{box-shadow:none!important;border:0!important}}</style></head><body class="bg-slate-50 text-slate-900"><div class="print:hidden"><%- include('../partials/navbar',{user:user||null}) %></div><main class="min-h-screen px-4 py-10"><section class="receipt mx-auto max-w-md rounded-3xl border border-slate-200 bg-white p-7 shadow-sm"><div class="text-center border-b border-dashed border-slate-300 pb-5"><h1 class="text-2xl font-black">ShopNexus</h1><p class="mt-2 text-sm text-slate-500">Kassa qəbzi</p><span class="mt-4 inline-block rounded-full border-2 border-emerald-500 px-3 py-1 text-sm font-black text-emerald-600">Ödənilib</span></div><div class="py-5 text-sm"><div class="flex justify-between"><span class="text-slate-500">Sifariş №</span><b><%= String(order._id).slice(0,8) %></b></div><div class="mt-2 flex justify-between"><span class="text-slate-500">Tarix</span><b><%= new Date(order.created_at).toLocaleString('az-AZ') %></b></div></div><div class="border-y border-dashed border-slate-300 py-3 space-y-3"><% items.forEach(i=>{ %><div class="flex justify-between gap-3"><span><%= i.product_name %> <small class="text-slate-500">× <%= i.quantity %></small></span><b><%= money(i.lineTotal) %> ₼</b></div><% }) %></div><div class="py-5 flex justify-between text-lg"><span class="font-bold">Cəmi</span><b><%= money(order.total_amount) %> ₼</b></div><div class="flex justify-between text-sm"><span class="text-slate-500">Ödəniş üsulu</span><b><%= order.payment_method %></b></div><button onclick="window.print()" class="no-print mt-7 w-full rounded-2xl bg-slate-950 py-3 font-black text-white hover:bg-teal-600"><i class="fa-solid fa-print mr-2"></i>Çap et / PDF yüklə</button></section></main><div class="print:hidden"><%- include('../partials/footer') %></div></body></html>