<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('vendor_products.title') %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-900">
  <%- include('../partials/navbar', { user: user || null }) %>
  <main class="mx-auto max-w-6xl px-4 py-8 sm:py-10">
    <h1 class="mb-6 text-3xl font-black sm:mb-8 sm:text-4xl"><%= t('vendor_products.title') %></h1>
    <section class="overflow-hidden rounded-3xl border bg-white">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[620px] text-left">
          <thead class="bg-slate-50 text-slate-500">
            <tr>
              <th class="px-5 py-4"><%= t('vendor_products.col_product') %></th>
              <th class="px-5 py-4"><%= t('vendor_products.col_category') %></th>
              <th class="px-5 py-4"><%= t('vendor_products.col_price') %></th>
              <th class="px-5 py-4"><%= t('vendor_products.col_stock') %></th>
              <th class="px-5 py-4"><%= t('vendor_products.col_action') %></th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(product => { %>
              <tr class="border-t">
                <td class="px-5 py-4 font-bold"><%= product.name %></td>
                <td class="px-5 py-4"><%= product.category || '—' %></td>
                <td class="px-5 py-4 whitespace-nowrap"><%= money(product.price) %> ₼</td>
                <td class="px-5 py-4"><%= product.stock_quantity %></td>
                <td class="px-5 py-4"><div class="flex items-center gap-3"><a href="/vendor/products/<%= product._id %>/edit" class="font-bold text-teal-600 hover:text-teal-800"><%= t('vendor_products.edit') %></a><form action="/vendor/products/<%= product._id %>/delete" method="POST" onsubmit="return confirm('<%= t('vendor_products.confirm_delete') %>')"><button class="font-bold text-rose-600 hover:text-rose-800"><i class="fa-solid fa-trash mr-1"></i><%= t('vendor_products.delete') %></button></form></div></td>
              </tr>
            <% }) %>
            <% if (!products.length) { %><tr><td colspan="5" class="px-5 py-12 text-center text-slate-500"><%= t('vendor_products.empty') %></td></tr><% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
