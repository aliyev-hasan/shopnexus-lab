<!DOCTYPE html><html lang="az"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Məhsulu Redaktə Et</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-50 text-slate-900"><%- include('../partials/navbar', { user: user || null }) %><main class="max-w-3xl mx-auto px-4 py-10"><h1 class="text-4xl font-black mb-8">Məhsulu Redaktə Et</h1><form action="/vendor/products/<%= product._id %>" method="POST" enctype="multipart/form-data" class="bg-white rounded-[2rem] p-6 border space-y-4"><input name="name" required value="<%= product.name %>" class="w-full rounded-2xl bg-slate-100 p-4" placeholder="Məhsul adı"><input name="price" required type="number" step="0.01" value="<%= product.price %>" class="w-full rounded-2xl bg-slate-100 p-4" placeholder="Qiymət"><input name="stock_quantity" type="number" value="<%= product.stock_quantity %>" class="w-full rounded-2xl bg-slate-100 p-4" placeholder="Stok"><select name="category" class="w-full rounded-2xl bg-slate-100 p-4"><option value="">Kateqoriya seç</option><% ['Elektronika','Geyim','Aksessuar','Ev əşyaları'].forEach(c=>{ %><option <%= product.category===c?'selected':'' %>><%= c %></option><% }) %></select><input type="file" name="image" accept="image/*" class="w-full rounded-2xl bg-slate-100 p-4"><textarea name="description" class="w-full rounded-2xl bg-slate-100 p-4" placeholder="Təsvir"><%= product.description || '' %></textarea><button class="rounded-2xl bg-teal-600 text-white px-6 py-3 font-black">Yadda saxla</button></form></main><%- include('../partials/footer') %></body></html>
