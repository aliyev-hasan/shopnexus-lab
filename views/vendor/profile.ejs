<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mağaza Profili | ShopNexus</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
  <%- include('../partials/navbar', { user: user || null }) %>
  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="mb-2 text-sm font-black uppercase tracking-[.2em] text-teal-600">Satıcı paneli</p><h1 class="text-4xl font-black tracking-tight">Mağaza Profili</h1><p class="mt-2 text-slate-500">Mağazanızın görünüşünü və məlumatlarını yeniləyin.</p></div>
      <a href="/vendor/dashboard" class="inline-flex items-center gap-2 font-black text-teal-600 hover:text-teal-800"><i class="fa-solid fa-arrow-left"></i> Dashboard-a qayıt</a>
    </div>

    <form action="/vendor/profile" method="POST" enctype="multipart/form-data" class="grid gap-8 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-9 lg:grid-cols-[1fr_280px]">
      <div class="space-y-6">
        <div>
          <label for="store_name" class="mb-2 block text-sm font-black text-slate-700">Mağaza adı</label>
          <input id="store_name" name="store_name" type="text" value="<%= vendor.store_name || '' %>" required class="w-full rounded-2xl border border-transparent bg-slate-100 px-4 py-3.5 outline-none transition focus:border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-500/20">
        </div>
        <div>
          <label for="store_description" class="mb-2 block text-sm font-black text-slate-700">Mağaza təsviri</label>
          <textarea id="store_description" name="store_description" rows="6" class="w-full resize-y rounded-2xl border border-transparent bg-slate-100 px-4 py-3.5 outline-none transition focus:border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-500/20"><%= vendor.store_description || '' %></textarea>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="store_logo" class="mb-2 block text-sm font-black text-slate-700">Mağaza loqosu</label>
            <input id="store_logo" name="store_logo" type="file" accept="image/*" class="w-full rounded-2xl bg-slate-100 px-3 py-3 text-sm">
            <p class="mt-2 text-xs text-slate-400">JPG, PNG və ya WEBP</p>
          </div>
          <div>
            <label for="store_banner" class="mb-2 block text-sm font-black text-slate-700">Mağaza banneri</label>
            <input id="store_banner" name="store_banner" type="file" accept="image/*" class="w-full rounded-2xl bg-slate-100 px-3 py-3 text-sm">
            <p class="mt-2 text-xs text-slate-400">Geniş ölçülü şəkil tövsiyə olunur</p>
          </div>
        </div>
        <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-slate-950 px-7 py-3.5 font-black text-white transition hover:bg-teal-600"><i class="fa-solid fa-floppy-disk"></i> Yadda saxla</button>
      </div>

      <aside class="space-y-5">
        <div><p class="mb-3 text-sm font-black text-slate-700">Mövcud logo</p><div class="grid min-h-40 place-items-center overflow-hidden rounded-3xl border border-slate-200 bg-slate-50"><% if (vendor.store_logo) { %><img src="<%= vendor.store_logo %>" alt="Mağaza loqosu" class="h-40 w-40 rounded-full object-cover"> <% } else { %><i class="fa-solid fa-store text-4xl text-slate-300"></i><% } %></div></div>
        <div><p class="mb-3 text-sm font-black text-slate-700">Mövcud banner</p><div class="flex min-h-32 items-center justify-center overflow-hidden rounded-3xl border border-slate-200 bg-slate-50"><% if (vendor.store_banner) { %><img src="<%= vendor.store_banner %>" alt="Mağaza banneri" class="h-32 w-full object-cover"> <% } else { %><i class="fa-solid fa-image text-4xl text-slate-300"></i><% } %></div></div>
      </aside>
    </form>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
