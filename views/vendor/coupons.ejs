<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('vendor_coupons.title') %> | ShopNexus</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
  <%- include('../partials/navbar', { user: user || null }) %>
  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="mb-2 text-sm font-black uppercase tracking-[.2em] text-teal-600"><%= t('vendor_coupons.panel_label') %></p><h1 class="text-4xl font-black tracking-tight"><%= t('vendor_coupons.title') %></h1><p class="mt-2 text-slate-500"><%= t('vendor_coupons.subtitle', { store: vendor.store_name }) %></p></div>
      <a href="/vendor/dashboard" class="inline-flex items-center gap-2 font-black text-teal-600 hover:text-teal-800"><i class="fa-solid fa-arrow-left"></i> <%= t('vendor_coupons.back_to_dashboard') %></a>
    </div>

    <form action="/vendor/coupons" method="POST" data-coupon-form class="grid gap-4 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8 sm:grid-cols-2 lg:grid-cols-6">
      <div class="sm:col-span-2 lg:col-span-1">
        <label class="mb-2 block text-sm font-black text-slate-700"><%= t('vendor_coupons.code_label') %></label>
        <input name="code" required placeholder="TECH10" class="w-full rounded-2xl border border-transparent bg-slate-100 px-4 py-3 outline-none focus:border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-500/20">
      </div>
      <div>
        <label class="mb-2 block text-sm font-black text-slate-700"><%= t('vendor_coupons.type_label') %></label>
        <select name="discount_type" class="w-full rounded-2xl border border-transparent bg-slate-100 px-4 py-3 outline-none focus:border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-500/20">
          <option value="percentage"><%= t('vendor_coupons.type_percentage') %></option>
          <option value="fixed"><%= t('vendor_coupons.type_fixed') %></option>
          <option value="first_order"><%= t('vendor_coupons.type_first_order') %></option>
        </select>
      </div>
      <div>
        <label class="mb-2 block text-sm font-black text-slate-700"><%= t('vendor_coupons.value_label') %></label>
        <input name="discount_value" required type="number" step="0.01" min="1" max="100" placeholder="10" class="w-full rounded-2xl border border-transparent bg-slate-100 px-4 py-3 outline-none focus:border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-500/20">
      </div>
      <div><label class="mb-2 block text-sm font-black text-slate-700">İstifadə limiti</label><input name="usage_limit" required type="number" step="1" min="1" max="1000" value="1000" class="w-full rounded-2xl border border-transparent bg-slate-100 px-4 py-3 outline-none focus:border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-500/20"></div>
      <div>
        <label class="mb-2 block text-sm font-black text-slate-700"><%= t('vendor_coupons.min_order_label') %></label>
        <input name="min_order_value" type="number" step="0.01" min="0" placeholder="0" class="w-full rounded-2xl border border-transparent bg-slate-100 px-4 py-3 outline-none focus:border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-500/20">
      </div>
      <div>
        <label class="mb-2 block text-sm font-black text-slate-700"><%= t('vendor_coupons.expiry_label') %></label>
        <input name="expiry_date" type="date" class="w-full rounded-2xl border border-transparent bg-slate-100 px-4 py-3 outline-none focus:border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-500/20">
      </div>
      <button class="sm:col-span-2 lg:col-span-6 inline-flex items-center justify-center gap-2 rounded-2xl bg-slate-950 px-7 py-3.5 font-black text-white transition hover:bg-teal-600"><i class="fa-solid fa-plus"></i> <%= t('vendor_coupons.create_button') %></button>
    </form>

    <div class="mt-8 overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 p-6"><h2 class="text-2xl font-black"><%= t('vendor_coupons.available_title') %></h2><p class="mt-1 text-sm text-slate-500"><%= t('vendor_coupons.available_subtitle') %></p></div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-left">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500"><tr><th class="px-6 py-4"><%= t('vendor_coupons.col_code') %></th><th class="px-6 py-4"><%= t('vendor_coupons.col_type') %></th><th class="px-6 py-4"><%= t('vendor_coupons.col_value') %></th><th class="px-6 py-4">Limit</th><th class="px-6 py-4"><%= t('vendor_coupons.col_min_order') %></th><th class="px-6 py-4"><%= t('vendor_coupons.col_expiry') %></th><th class="px-6 py-4"><%= t('vendor_coupons.col_action') %></th></tr></thead>
          <tbody>
            <% if (!(coupons||[]).length) { %>
              <tr><td colspan="7" class="px-6 py-12 text-center text-slate-500"><%= t('vendor_coupons.empty') %></td></tr>
            <% } %>
            <% (coupons||[]).forEach(c => { %>
              <tr class="border-t border-slate-100">
                <td class="px-6 py-4 font-black"><%= c.code %></td>
                <td class="px-6 py-4 text-slate-500"><%= c.discount_type === 'percentage' ? t('vendor_coupons.type_percentage') : c.discount_type === 'first_order' ? t('vendor_coupons.type_first_order') : t('vendor_coupons.type_fixed') %></td>
                <td class="px-6 py-4 font-bold"><%= c.discount_value %><%= c.discount_type === 'percentage' || c.discount_type === 'first_order' ? '%' : ' ₼' %></td>
                <td class="px-6 py-4"><%= c.used_count || 0 %> / <%= c.usage_limit || 1000 %></td>
                <td class="px-6 py-4"><%= c.min_order_value ? c.min_order_value + ' ₼' : '—' %></td>
                <td class="px-6 py-4"><%= c.expiry_date ? new Date(c.expiry_date).toLocaleDateString(dateLocale) : '—' %></td>
                <td class="px-6 py-4"><form action="/vendor/coupons/<%= c._id %>/delete" method="POST" onsubmit="return confirm('<%= t('vendor_coupons.confirm_delete') %>')"><button class="font-bold text-rose-600 hover:text-rose-800"><%= t('vendor_coupons.delete') %></button></form></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/coupon-validation.js"></script>
</body>
</html>
