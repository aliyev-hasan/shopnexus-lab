<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Müştəri mesajları | ShopNexus</title>
  <script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="min-h-screen bg-slate-50 text-slate-900">
  <%- include('../partials/navbar',{user:user||null}) %>
  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-black uppercase tracking-widest text-teal-700">Satıcı paneli</p><h1 class="text-4xl font-black">Müştəri mesajları</h1><p class="mt-2 text-slate-500">Mağazanızla birbaşa əlaqə saxlayan müştərilərə buradan cavab verin.</p></div><a href="/vendor/dashboard" class="font-black text-teal-700"><i class="fa-solid fa-arrow-left mr-2"></i>Panelə qayıt</a></div>
    <% if(!(conversations||[]).length){ %><section class="rounded-3xl border bg-white p-12 text-center text-slate-500"><i class="fa-regular fa-comments mb-3 text-4xl"></i><p class="font-bold">Hələ müştəri mesajı yoxdur.</p></section><% } %>
    <div class="space-y-5"><% (conversations||[]).forEach(conversation=>{ %>
      <article id="conversation-<%= conversation._id %>" class="scroll-mt-6 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3"><div><h2 class="text-xl font-black"><i class="fa-solid fa-user mr-2 text-teal-600"></i><%= conversation.customer ? conversation.customer.full_name : 'Silinmiş müştəri' %></h2><p class="mt-1 text-xs text-slate-400"><%= conversation.customer ? conversation.customer.email : conversation.user_id %></p></div><span class="rounded-full px-3 py-1 text-xs font-black <%= conversation.status==='ANSWERED'?'bg-emerald-100 text-emerald-700':'bg-amber-100 text-amber-800' %>"><%= conversation.status==='ANSWERED'?'Cavab verilib':'Cavab gözləyir' %></span></div>
        <div class="mb-5 max-h-[28rem] space-y-3 overflow-y-auto rounded-2xl bg-slate-50 p-4"><% (conversation.messages||[]).forEach(message=>{ const mine=message.sender==='vendor'; %><div class="flex <%= mine?'justify-end':'justify-start' %>"><div class="max-w-[85%] rounded-2xl px-4 py-3 <%= mine?'bg-teal-600 text-white':'border bg-white text-slate-800' %>"><p class="text-xs font-black <%= mine?'text-teal-100':'text-slate-500' %>"><%= mine?'Siz':(conversation.customer?conversation.customer.full_name:'Müştəri') %> · <%= new Date(message.created_at).toLocaleString(currentLang) %></p><p class="mt-1 whitespace-pre-wrap"><%= message.text %></p></div></div><% }) %></div>
        <form action="/vendor/customer-support/<%= conversation._id %>/reply" method="POST" class="flex flex-col gap-3 sm:flex-row"><textarea name="message" required maxlength="2000" rows="2" placeholder="Müştəriyə cavab yazın..." class="min-w-0 flex-1 rounded-2xl border border-slate-300 p-3 outline-none focus:border-teal-500 focus:ring-4 focus:ring-teal-500/10"></textarea><button class="rounded-2xl bg-slate-950 px-6 py-3 font-black text-white hover:bg-teal-700"><i class="fa-solid fa-reply mr-2"></i>Cavabla</button></form>
      </article>
    <% }) %></div>
  </main>
  <%- include('../partials/footer') %>
</body></html>
