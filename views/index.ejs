<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'ShopNexus' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-900">
  <%- include('partials/navbar', { user: user || null }) %>
  <main>
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-teal-950 to-rose-900 text-white">
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_20%_20%,white,transparent_25%),radial-gradient(circle_at_80%_30%,#f0abfc,transparent_25%)]"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-flex px-4 py-2 rounded-full bg-white/10 border border-white/20 text-sm font-bold mb-6"><i class="fa-solid fa-bolt mr-2 text-yellow-300"></i> <%= t('home.promo_badge') %></span>
          <h1 class="text-5xl md:text-7xl font-black leading-tight"><%= t('home.hero_title') %></h1>
          <p class="mt-6 text-xl text-slate-200 max-w-xl"><%= t('home.hero_subtitle') %></p>
          <div class="mt-8 flex flex-wrap gap-4"><a href="/products" class="px-7 py-4 rounded-2xl bg-white text-slate-950 font-black shadow-lg hover:bg-teal-50 hover:scale-105 transition"><%= t('home.shop_now') %></a><a href="#deals" class="px-7 py-4 rounded-2xl bg-slate-900/80 border border-white/50 text-white font-black shadow-lg hover:bg-white hover:text-slate-950 transition"><%= t('home.today_deals') %></a></div>
        </div>
        <div class="relative"><div class="rounded-[2.5rem] bg-white/10 p-4 shadow-2xl border border-white/20"><img class="rounded-[2rem] w-full h-[430px] object-cover" src="https://images.unsplash.com/photo-1607082349566-187342175e2f?auto=format&fit=crop&w=1200&q=80"></div></div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10 bg-slate-50">
      <div class="mb-5 flex items-end justify-between"><div><p class="text-sm font-black uppercase tracking-wider text-teal-700"><%= t('home.categories_label') %></p><h2 class="text-2xl font-black text-slate-950"><%= t('home.categories_title') %></h2></div></div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <a href="/products?category=Elektronika" class="group relative overflow-hidden rounded-3xl bg-slate-950 p-6 text-white shadow-xl hover:-translate-y-1 transition lg:col-span-2 min-h-[220px] flex flex-col justify-end">
          <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=900&q=80" class="absolute inset-0 h-full w-full object-cover opacity-30 group-hover:scale-105 group-hover:opacity-40 transition duration-500" alt="<%= t('home.cat_electronics_title') %>">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-transparent"></div>
          <div class="relative"><span class="inline-flex h-12 w-12 place-items-center rounded-2xl bg-teal-600 text-white text-xl mb-3"><i class="fa-solid fa-mobile-screen"></i></span><h3 class="text-2xl font-black"><%= t('home.cat_electronics_title') %></h3><p class="text-slate-300 text-sm"><%= t('home.cat_electronics_desc') %></p></div>
        </a>
        <a href="/products?category=Geyim" class="group relative overflow-hidden rounded-3xl bg-white p-6 shadow-xl hover:-translate-y-1 transition">
          <div class="h-12 w-12 rounded-2xl bg-gradient-to-br from-pink-500 to-rose-600 text-white grid place-items-center text-xl mb-4"><i class="fa-solid fa-shirt"></i></div><h3 class="font-black text-xl"><%= t('home.cat_clothing_title') %></h3><p class="text-slate-500 text-sm"><%= t('home.cat_clothing_desc') %></p>
        </a>
        <a href="/products?category=Aksessuar" class="group relative overflow-hidden rounded-3xl bg-white p-6 shadow-xl hover:-translate-y-1 transition">
          <div class="h-12 w-12 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 text-white grid place-items-center text-xl mb-4"><i class="fa-solid fa-gem"></i></div><h3 class="font-black text-xl"><%= t('home.cat_accessories_title') %></h3><p class="text-slate-500 text-sm"><%= t('home.cat_accessories_desc') %></p>
        </a>
        <a href="/products?category=Ev əşyaları" class="group relative overflow-hidden rounded-3xl bg-slate-950 p-6 text-white shadow-xl hover:-translate-y-1 transition lg:col-span-2 min-h-[160px] flex flex-col justify-end">
          <img src="https://images.unsplash.com/photo-1533090481720-856c6e3c1fdc?auto=format&fit=crop&w=900&q=80" class="absolute inset-0 h-full w-full object-cover opacity-30 group-hover:scale-105 group-hover:opacity-40 transition duration-500" alt="<%= t('home.cat_home_title') %>">
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-transparent"></div>
          <div class="relative"><span class="inline-flex h-12 w-12 place-items-center rounded-2xl bg-emerald-600 text-white text-xl mb-3"><i class="fa-solid fa-couch"></i></span><h3 class="text-2xl font-black"><%= t('home.cat_home_title') %></h3><p class="text-slate-300 text-sm"><%= t('home.cat_home_desc') %></p></div>
        </a>
        <a href="/products?category=Kosmetika" class="group relative overflow-hidden rounded-3xl bg-white p-6 shadow-xl hover:-translate-y-1 transition">
          <div class="h-12 w-12 rounded-2xl bg-gradient-to-br from-fuchsia-500 to-pink-600 text-white grid place-items-center text-xl mb-4"><i class="fa-solid fa-spa"></i></div><h3 class="font-black text-xl"><%= t('home.cat_cosmetics_title') %></h3><p class="text-slate-500 text-sm"><%= t('home.cat_cosmetics_desc') %></p>
        </a>
        <a href="/products?category=İdman" class="group relative overflow-hidden rounded-3xl bg-white p-6 shadow-xl hover:-translate-y-1 transition">
          <div class="h-12 w-12 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white grid place-items-center text-xl mb-4"><i class="fa-solid fa-dumbbell"></i></div><h3 class="font-black text-xl"><%= t('home.cat_sports_title') %></h3><p class="text-slate-500 text-sm"><%= t('home.cat_sports_desc') %></p>
        </a>
      </div>
    </section>

    <section id="deals" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="rounded-[2rem] bg-gradient-to-r from-rose-600 to-orange-500 text-white p-8 mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div><p class="text-sm font-black uppercase tracking-wider text-rose-100"><%= t('home.flash_sale_label') %></p><h2 class="text-3xl sm:text-4xl font-black"><%= t('home.deals_title') %></h2><p class="text-rose-100 mt-1"><%= t('home.deals_subtitle') %></p></div>
        <a href="/products" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-6 py-3 font-black text-rose-700 hover:bg-rose-50 transition whitespace-nowrap"><%= t('home.view_all') %> <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6"><% (featured || []).slice(0,4).forEach(product => { %><%- include('partials/product-card', { product }) %><% }) %></div>
    </section>

    <% if ((featuredVendors || []).length) { %>
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div><p class="text-sm font-black uppercase tracking-wider text-teal-600"><%= t('home.featured_vendors_label') %></p><h2 class="text-3xl font-black"><%= t('home.featured_vendors_title') %></h2></div>
        <a href="/vendors" class="inline-flex items-center gap-2 rounded-2xl bg-teal-600 px-5 py-3 font-black text-white shadow-lg shadow-teal-600/20 hover:bg-teal-700">Bütün satıcılara bax <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% featuredVendors.forEach(fv => { const v = fv.vendor; %>
        <div class="group bg-white rounded-[1.75rem] overflow-hidden shadow-sm border border-slate-200 hover:shadow-2xl hover:-translate-y-1 transition">
          <div class="relative h-36 overflow-hidden bg-slate-950">
            <% if (v.store_banner) { %>
              <img src="<%= v.store_banner %>" class="w-full h-full object-cover opacity-70 group-hover:scale-110 transition duration-500">
            <% } else { %>
              <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-teal-950 to-slate-900"></div>
            <% } %>
            <div class="absolute -bottom-7 left-5">
              <% if (v.store_logo) { %>
                <img src="<%= v.store_logo %>" class="h-16 w-16 rounded-2xl border-4 border-white object-cover shadow-lg bg-white">
              <% } else { %>
                <div class="h-16 w-16 rounded-2xl border-4 border-white bg-teal-600 text-white grid place-items-center shadow-lg"><i class="fa-solid fa-store text-xl"></i></div>
              <% } %>
            </div>
          </div>
          <div class="p-5 pt-9">
            <h3 class="font-black text-lg line-clamp-1"><%= v.store_name %></h3>
            <p class="text-sm text-slate-500 mt-1 line-clamp-2 min-h-[2.5rem]"><%= v.store_description || t('home.vendor_default_desc') %></p>
            <div class="mt-3 flex items-center gap-2 flex-wrap">
              <% if (fv.categories && fv.categories[0]) { %><span class="px-3 py-1 rounded-full bg-teal-50 text-teal-700 text-xs font-bold"><%= fv.categories[0] %></span><% } %>
              <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-bold"><%= fv.productCount %> <%= t('home.product_count_suffix') %></span>
              <% if (fv.rating > 0) { %><span class="text-xs font-bold text-amber-600"><i class="fa-solid fa-star"></i> <%= fv.rating.toFixed(1) %></span><% } %>
            </div>
            <a href="/vendors/<%= v.slug || v._id %>" class="mt-5 block text-center px-4 py-3 rounded-2xl bg-slate-950 text-white font-bold hover:bg-teal-600"><%= t('home.visit_store') %></a>
          </div>
        </div>
        <% }) %>
      </div>
    </section>
    <% } %>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 grid lg:grid-cols-2 gap-8"><div class="rounded-[2rem] bg-slate-900 text-white p-10"><h2 class="text-3xl font-black mb-3"><%= t('home.bestsellers_title') %></h2><p class="text-slate-300 mb-6"><%= t('home.bestsellers_subtitle') %></p><a class="px-6 py-3 rounded-2xl bg-white text-slate-950 font-bold" href="/products?sort=popular"><%= t('home.discover') %></a></div><div class="rounded-[2rem] bg-gradient-to-br from-teal-600 to-emerald-600 text-white p-10"><h2 class="text-3xl font-black mb-3"><%= t('home.new_arrivals_title') %></h2><p class="text-teal-100 mb-6"><%= t('home.new_arrivals_subtitle') %></p><a class="px-6 py-3 rounded-2xl bg-white text-slate-950 font-bold" href="/products?sort=newest"><%= t('home.view') %></a></div></section>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
