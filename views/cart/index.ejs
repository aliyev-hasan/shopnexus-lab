<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Səbət | ShopNexus</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-900">
  <%- include('../partials/navbar', { user: user || null }) %>
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <h1 class="mb-6 text-3xl font-black sm:mb-8 sm:text-4xl">Səbət</h1>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_380px]">
      <section class="space-y-4">
        <% if (!items.length) { %>
          <div class="rounded-3xl bg-white p-8 text-center sm:p-10">Səbət boşdur. <a class="font-bold text-teal-600" href="/products">Məhsullara bax</a></div>
        <% } %>
        <% items.forEach(item => { %>
          <article class="flex flex-col gap-4 rounded-3xl border bg-white p-4 sm:flex-row sm:gap-5 sm:p-5">
            <img src="<%= item.product.image_url %>" alt="<%= item.product.name %>" class="h-44 w-full rounded-2xl object-cover sm:h-28 sm:w-28 sm:shrink-0">
            <div class="min-w-0 flex-1">
              <h2 class="break-words text-lg font-black sm:text-xl"><%= item.product.name %></h2>
              <p class="text-sm text-slate-500">Qiymət: <%= money(item.product.price) %> ₼</p>
              <p class="mt-2 text-2xl font-black"><%= money(item.lineTotal) %> ₼</p>
              <div class="mt-3 flex flex-wrap items-center gap-2 sm:gap-3">
                <form action="/cart/update" method="POST" class="flex items-center">
                  <input type="hidden" name="productId" value="<%= item.product_id %>">
                  <input type="hidden" name="quantity" value="<%= item.quantity - 1 %>">
                  <button class="grid h-10 w-10 place-items-center rounded-xl bg-slate-100 font-black" <%= item.quantity <= 1 ? 'disabled' : '' %> aria-label="Miqdarı azalt">−</button>
                </form>
                <span class="min-w-6 text-center text-lg font-black"><%= item.quantity %></span>
                <form action="/cart/update" method="POST">
                  <input type="hidden" name="productId" value="<%= item.product_id %>">
                  <input type="hidden" name="quantity" value="<%= item.quantity + 1 %>">
                  <button class="grid h-10 w-10 place-items-center rounded-xl bg-slate-100 font-black" aria-label="Miqdarı artır">+</button>
                </form>
                <form action="/cart/remove" method="POST" class="ml-1">
                  <input type="hidden" name="productId" value="<%= item.product_id %>">
                  <button class="rounded-xl px-3 py-2 font-bold text-rose-600 hover:bg-rose-50">Sil</button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      </section>
      <aside class="h-fit rounded-3xl border bg-white p-5 sm:p-6 lg:sticky lg:top-24">
        <h2 class="mb-5 text-2xl font-black">Sifariş xülasəsi</h2>
        <div class="flex justify-between gap-4 border-b py-3"><span>Ara cəmi</span><strong class="whitespace-nowrap"><%= money(subtotal) %> ₼</strong></div>
        <% if (discount > 0) { %><div class="flex justify-between gap-4 border-b py-3 text-emerald-600"><span>Endirim</span><strong class="whitespace-nowrap">−<%= money(discount) %> ₼</strong></div><% } %>
        <div class="flex justify-between gap-4 border-b py-3 text-xl"><span>Cəmi</span><strong class="whitespace-nowrap font-black"><%= money(total) %> ₼</strong></div>
        <form action="/cart/apply-coupon" method="POST" class="mt-5">
          <input name="code" class="w-full rounded-2xl bg-slate-100 p-4" placeholder="Kupon kodu: NEXUS10" value="<%= couponCode || '' %>">
          <button class="mt-2 w-full rounded-2xl bg-slate-200 py-3 font-bold">Kupon tətbiq et</button>
        </form>
        <% if (couponCode) { %><p class="mt-2 text-xs text-emerald-600">Tətbiq olunan kupon: <%= couponCode %></p><% } %>
        <% if (items.length) { %><a href="/checkout" class="mt-5 block rounded-2xl bg-slate-950 py-4 text-center font-black text-white">Checkout</a><% } %>
      </aside>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
