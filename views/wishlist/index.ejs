<!DOCTYPE html><html lang="az"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>İstək Siyahısı</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head><body class="bg-slate-50 text-slate-900"><%- include('../partials/navbar', { user: user || null }) %><main class="max-w-7xl mx-auto px-4 py-10"><h1 class="text-4xl font-black mb-8">İstək Siyahısı</h1><% if(!items.length){ %><div class="bg-white rounded-3xl p-10 text-center">İstək siyahısı boşdur. <a class="text-teal-600 font-bold" href="/products">Məhsullara bax</a></div><% } else { %><div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5"><% items.forEach(p=>{ %><div class="bg-white rounded-[1.75rem] overflow-hidden border shadow-sm"><div class="h-56 overflow-hidden bg-slate-100"><img src="<%= p.image_url %>" class="w-full h-full object-cover"></div><div class="p-5"><p class="text-sm text-teal-600 font-bold"><%= p.category %></p><h3 class="font-black text-lg"><%= p.name %></h3><p class="text-2xl font-black mt-2"><%= money(p.price) %> ₼</p><div class="mt-4 flex gap-2"><a href="/products/<%= p._id %>" class="flex-1 text-center px-3 py-2 rounded-xl bg-slate-950 text-white font-bold text-sm">Ətraflı</a><form action="/wishlist/move-to-cart" method="POST" class="flex-1"><input type="hidden" name="productId" value="<%= p._id %>"><button class="w-full px-3 py-2 rounded-xl bg-teal-600 text-white font-bold text-sm">Səbətə at</button></form><button type="button" aria-label="İstək siyahısından sil" class="wishlist-toggle px-3 py-2 rounded-xl bg-rose-50 text-rose-600 font-bold text-sm" data-product-id="<%= p._id %>" title="Sil"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></div></div></div><% }) %></div><% } %></main><%- include('../partials/footer') %><script src="/js/main.js"></script></body></html>
