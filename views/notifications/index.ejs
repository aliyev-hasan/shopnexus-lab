<!DOCTYPE html><html lang="<%= currentLang %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Bildirişlər | ShopNexus</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"></head>
<body class="bg-slate-50 text-slate-900"><%- include('../partials/navbar',{user:user||null}) %><main class="mx-auto max-w-4xl px-4 py-10">
  <div class="mb-7 flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-black uppercase tracking-wider text-teal-700">Notification Center</p><h1 class="text-4xl font-black">Bildirişlər</h1><p class="mt-2 text-slate-500">Hesabınızla əlaqəli yeniliklər və tələb olunan hərəkətlər.</p></div><% if((notifications||[]).some(n=>!n.read_at)){ %><form action="/notifications/read-all" method="POST"><button class="rounded-xl bg-slate-950 px-5 py-3 font-bold text-white hover:bg-teal-700">Hamısını oxunmuş et</button></form><% } %></div>
  <section class="overflow-hidden rounded-3xl border bg-white shadow-sm"><% if(!(notifications||[]).length){ %><div class="p-12 text-center text-slate-500"><i class="fa-regular fa-bell mb-3 text-4xl"></i><p class="font-bold">Bildiriş yoxdur.</p></div><% } %><% (notifications||[]).forEach(n=>{ %><a href="/notifications/<%= n._id %>/open" class="flex gap-4 border-b p-5 transition hover:bg-slate-50 <%= n.read_at?'':'bg-teal-50/60' %>"><span class="mt-1 grid h-11 w-11 shrink-0 place-items-center rounded-2xl <%= n.read_at?'bg-slate-100 text-slate-500':'bg-teal-600 text-white' %>"><i class="fa-solid <%= n.type.includes('QUESTION')?'fa-circle-question':n.type.includes('ORDER')?'fa-box':n.type.includes('SUPPORT')?'fa-life-ring':n.type.includes('RETURN')?'fa-rotate-left':n.type.includes('PAYMENT')?'fa-credit-card':'fa-bell' %>"></i></span><span class="min-w-0 flex-1"><span class="flex flex-wrap items-center gap-2"><strong><%= n.title %></strong><span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-bold text-slate-500"><%= n.type %></span><% if(!n.read_at){ %><span class="h-2 w-2 rounded-full bg-rose-600" aria-label="Oxunmamış"></span><% } %></span><span class="mt-1 block text-sm text-slate-600"><%= n.message %></span><time class="mt-2 block text-xs text-slate-400"><%= new Date(n.created_at).toLocaleString(currentLang) %></time></span><i class="fa-solid fa-chevron-right self-center text-slate-300"></i></a><% }) %></section>
</main><%- include('../partials/footer') %></body></html>
